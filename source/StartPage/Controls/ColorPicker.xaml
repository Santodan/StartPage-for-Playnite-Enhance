<UserControl x:Class="LandingPage.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander>
        <Expander.Header>
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <Border x:Name="Preview" Width="36" Height="24" CornerRadius="4" BorderBrush="#808080" BorderThickness="1" Margin="0,0,10,0"/>
                <TextBlock x:Name="ColorLabel" VerticalAlignment="Center"/>
            </StackPanel>
        </Expander.Header>
        <StackPanel Margin="8">
            <WrapPanel x:Name="Palette" Margin="0,0,0,8"/>
            <TextBlock Text="Red"/>
            <Slider x:Name="Red" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
            <TextBlock Text="Green"/>
            <Slider x:Name="Green" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
            <TextBlock Text="Blue"/>
            <Slider x:Name="Blue" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
            <TextBlock Text="Alpha (transparency)"/>
            <Slider x:Name="Alpha" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
            <TextBlock Text="Color name or hex" Margin="0,6,0,0"/>
            <TextBox x:Name="HexInput"/>
        </StackPanel>
    </Expander>
</UserControl>
