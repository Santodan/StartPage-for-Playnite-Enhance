  <CheckBox Content="Never played only" IsChecked="{Binding NeverPlayedOnly}"/>
  <TextBlock Text="No recorded playtime and no last played date." TextWrapping="Wrap" Margin="0,3,0,6"/>
  <CheckBox Content="Minimum days since last played" IsChecked="{Binding UseInactivityRule}"/>
  <numeric:IntBox Value="{Binding InactiveDays, UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="36500" Style="{StaticResource {x:Type TextBox}}"/>
  <CheckBox Content="Include never-played games in inactivity rule" IsChecked="{Binding IncludeNeverPlayedInInactivity}" Margin="0,4,0,8"/>
  <CheckBox Content="Minimum days since added" IsChecked="{Binding UseMinimumAddedAge}"/>
  <numeric:IntBox Value="{Binding MinimumAddedDays, UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="36500" Style="{StaticResource {x:Type TextBox}}"/>
  <CheckBox Content="Maximum days since added" IsChecked="{Binding UseMaximumAddedAge}" Margin="0,6,0,0"/>
  <numeric:IntBox Value="{Binding MaximumAddedDays, UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="36500" Style="{StaticResource {x:Type TextBox}}"/>
  <TextBlock Text="Day ranges include both endpoints; 0 means today. Minimum must not exceed maximum. Games without an added date are omitted when an added-date rule is enabled." TextWrapping="Wrap" Margin="0,4,0,8"/>
  <TextBlock Text="Match active include groups"/>
  <ComboBox SelectedValue="{Binding FilterMatchMode}" SelectedValuePath="Tag">
   <ComboBoxItem Content="All groups" Tag="{x:Static models:ShelfMatchMode.All}"/>
   <ComboBoxItem Content="Any group" Tag="{x:Static models:ShelfMatchMode.Any}"/>
  </ComboBox>
  <CheckBox Content="Require all selected values within each group" IsChecked="{Binding MatchAllSelectedValues}" Margin="0,6,0,0"/>
  <TextBlock Text="Applies to categories, tags, genres, platforms and features. Sources and completion statuses match any selected value." TextWrapping="Wrap" Margin="0,4,0,8"/>
  <TextBlock Text="Empty selections add no restriction. Use separate Include and Exclude selections under Filters. Exclusions always remove matches. Date/activity rules, installed/favorite/hidden switches, and ignored games always apply. Reset filters restores these advanced rules too." TextWrapping="Wrap" Margin="0,6,0,0"/>
 </StackPanel>
</UserControl>
