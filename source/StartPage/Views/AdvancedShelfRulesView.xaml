      <TextBlock Tag="{Binding ElementName=ExcludedSortingNamePatternsBox}" Style="{StaticResource PatternErrorTextStyle}"/>
     </StackPanel>
    </Expander>
    <Expander Header="Launch paths" Margin="0,2">
     <StackPanel Margin="8,4,0,8">
      <TextBlock Text="Matches recorded custom game actions, including additional actions. Plugin-generated actions are unavailable here." TextWrapping="Wrap" Margin="0,0,0,4"/>
