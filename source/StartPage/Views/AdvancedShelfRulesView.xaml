<UserControl x:Class="LandingPage.Views.AdvancedShelfRulesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="clr-namespace:LandingPage.Models"
 xmlns:numeric="http://gu.se/NumericInput">
 <UserControl.Resources>
  <Style x:Key="PatternErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Visibility" Value="Collapsed"/>
   <Setter Property="Text" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag.(Validation.Errors)[0].ErrorContent}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag.(Validation.HasError)}" Value="True">
     <Setter Property="Visibility" Value="Visible"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <StackPanel Margin="0,6">
  <DockPanel Margin="0,0,0,6">
     <Button Content="?" DockPanel.Dock="Right" Click="PatternHelp_Click" MinWidth="26" Padding="6,2" ToolTip="Open the shelf pattern guide on GitHub" AutomationProperties.Name="Open shelf pattern guide on GitHub"/>
     <TextBlock Text="Wildcard and text patterns" VerticalAlignment="Center"/>
  </DockPanel>
  <Expander Header="Pattern filters" Margin="0,0,0,8">
   <StackPanel Margin="8,6,0,0">
    <TextBlock Text="One pattern per line. * matches any characters; ? matches one. Case is ignored. Use *text* for part of a value. Include and exclude work together; exclusions win. Blank fields add no restriction." TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBlock Text="More options: glob: for character sets/ranges, regex:, literal:, contains:, starts:, ends:, and missing: for empty fields. Click ? for examples and field details." TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Expander Header="Game names" Margin="0,2">
     <StackPanel Margin="8,4,0,8">
      <TextBlock Text="Include" Margin="0,4,0,2"/>
      <TextBox x:Name="IncludedNamePatternsBox" Text="{Binding IncludedNamePatterns, UpdateSourceTrigger=PropertyChanged, Delay=500, ValidatesOnDataErrors=True}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="48" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      <TextBlock Tag="{Binding ElementName=IncludedNamePatternsBox}" Style="{StaticResource PatternErrorTextStyle}"/>
      <TextBlock Text="Exclude" Margin="0,4,0,2"/>
      <TextBox x:Name="ExcludedNamePatternsBox" Text="{Binding ExcludedNamePatterns, UpdateSourceTrigger=PropertyChanged, Delay=500, ValidatesOnDataErrors=True}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="48" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      <TextBlock Tag="{Binding ElementName=ExcludedNamePatternsBox}" Style="{StaticResource PatternErrorTextStyle}"/>
     </StackPanel>
    </Expander>
    <Expander Header="Installation directories" Margin="0,2">
     <StackPanel Margin="8,4,0,8">
      <TextBlock Text="Example: D:\Games\* includes subfolders of that directory." TextWrapping="Wrap" Margin="0,0,0,4"/>
      <TextBlock Text="Include" Margin="0,4,0,2"/>
      <TextBox x:Name="IncludedInstallPathPatternsBox" Text="{Binding IncludedInstallPathPatterns, UpdateSourceTrigger=PropertyChanged, Delay=500, ValidatesOnDataErrors=True}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="48" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      <TextBlock Tag="{Binding ElementName=IncludedInstallPathPatternsBox}" Style="{StaticResource PatternErrorTextStyle}"/>
      <TextBlock Text="Exclude" Margin="0,4,0,2"/>
      <TextBox x:Name="ExcludedInstallPathPatternsBox" Text="{Binding ExcludedInstallPathPatterns, UpdateSourceTrigger=PropertyChanged, Delay=500, ValidatesOnDataErrors=True}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="48" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      <TextBlock Tag="{Binding ElementName=ExcludedInstallPathPatternsBox}" Style="{StaticResource PatternErrorTextStyle}"/>
     </StackPanel>
    </Expander>
    <Expander Header="Sorting names" Margin="0,2">
     <StackPanel Margin="8,4,0,8">
      <TextBlock Text="Include" Margin="0,4,0,2"/>
