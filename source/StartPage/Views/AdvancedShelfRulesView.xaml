    <TextBlock Text="Each include field accepts any matching line. Different fields must all match. For multi-value fields, any recorded value can match. Pattern restrictions apply regardless of the All/Any setting below. Reset filters clears these patterns too." TextWrapping="Wrap" Margin="0,6,0,0"/>
   </StackPanel>
