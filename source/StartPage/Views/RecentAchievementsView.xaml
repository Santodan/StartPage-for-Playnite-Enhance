<UserControl x:Class="LandingPage.Views.RecentAchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LandingPage.Views"
             xmlns:m="clr-namespace:LandingPage.ViewModels.SuccessStory"
             xmlns:conv="clr-namespace:LandingPage.Converters" xmlns:system="clr-namespace:System;assembly=System"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=False, Type=m:SuccessStoryViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <conv:AchievementToImageConverter x:Key="AchievementToImageConverter"/>
        <system:Uri x:Key="DefaultAchievementUri">pack://application:,,,/StartPagePlugin;component/star.png</system:Uri>
        <conv:AchievementsToProgressConverter x:Key="AchievementsToProgressConverter"/>
    </UserControl.Resources>
    <Grid ClipToBounds="False">
        <Border CornerRadius="15" Background="#4C424242" Visibility="Hidden">
        </Border>
        <ListBox ItemsSource="{Binding Inner.LatestAchievementsView}" SelectionMode="Single"
                 Background="Transparent" BorderBrush="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Padding="15,0"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.VirtualizationMode="Standard"
                 UseLayoutRounding="False"
                 ClipToBounds="False">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem" BasedOn="{StaticResource {x:Type GroupItem}}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                    <StackPanel>
                                        <Button Click="Button_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock x:Name="RecentGroupTitle" Text="{Binding Name.GameName}"/>
                                        </Button>
                                        <ProgressBar x:Name="AchievementsProgress" Height="2" Margin="0,3,0,1" HorizontalAlignment="Stretch"
                                                        Width="Auto" 
                                                        Minimum="0" Maximum="1">
                                            <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.ShowGroupProgress, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Settings.RecentGrouping, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="UnlockDay"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Settings.RecentGrouping, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="Source"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Settings.RecentGrouping, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="Platform"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Settings.CustomizeRecentProgress, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"><Setter Property="Foreground" Value="{Binding Settings.ProgressColor, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/></DataTrigger>
                                            </Style.Triggers></Style></ProgressBar.Style>
                                            <ProgressBar.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Value" 
                                                                                Duration="0:0:1"
                                                                                From="0"
                                                                                To="{Binding Name.Progress ,Mode=OneWay}">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BounceEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </ProgressBar.Triggers>
                                        </ProgressBar>
                                        <ItemsPresenter Margin="5"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Settings.CustomizeRecentTypography, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"><Setter TargetName="RecentGroupTitle" Property="FontSize" Value="{Binding Settings.TitleSize, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Settings.CustomTextColors, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"><Setter TargetName="RecentGroupTitle" Property="Foreground" Value="{Binding Settings.TitleColor, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/></DataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Settings.CustomizeRecentTypography, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/><Condition Binding="{Binding Settings.Bold, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="RecentGroupTitle" Property="FontWeight" Value="Bold"/></MultiDataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Settings.CustomizeRecentTypography, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/><Condition Binding="{Binding Settings.Italic, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="RecentGroupTitle" Property="FontStyle" Value="Italic"/></MultiDataTrigger>

                                        <DataTrigger Binding="{Binding Settings.TextStyles[GroupTitle].UseDefaults, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="False">
                                            <Setter TargetName="RecentGroupTitle" Property="FontSize" Value="{Binding Settings.TextStyles[GroupTitle].Size, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/>
                                            <Setter TargetName="RecentGroupTitle" Property="FontWeight" Value="{Binding Settings.TextStyles[GroupTitle].FontWeight, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/>
                                            <Setter TargetName="RecentGroupTitle" Property="FontStyle" Value="{Binding Settings.TextStyles[GroupTitle].FontStyle, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Settings.TextStyles[GroupTitle].UseDefaults, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="False"/>
                                            <Condition Binding="{Binding Settings.TextStyles[GroupTitle].UseCustomColor, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/>
                                        </MultiDataTrigger.Conditions><Setter TargetName="RecentGroupTitle" Property="Foreground" Value="{Binding Settings.TextStyles[GroupTitle].Color, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/></MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                    <GroupStyle.Panel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </GroupStyle.Panel>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter Margin="1"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="3" RenderTransformOrigin="0.5,0.5" ClipToBounds="False"
                        RenderOptions.BitmapScalingMode="Fant">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform/>
                                <ScaleTransform x:Name="ItemScaleTransform"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush    x:Name="ItemBackgroundBrush"
                                                StartPoint="0,0" EndPoint="1,0" Opacity="0.15">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStop Color="White"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!--<Grid.ToolTip>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Achievement.DateUnlocked, Converter={StaticResource DateTimeToLastPlayedConverter}}" Margin="0,0,0,5"/>
                                    <TextBlock Text=" - " Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Achievement.DateUnlocked, StringFormat=HH:mm}" Margin="0,0,0,5"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Achievement.Description}"/>
                            </StackPanel>
                        </Grid.ToolTip>-->
                            <Border x:Name="AchievementIcon" Width="35" Height="35" Margin="0,0,10,0" CornerRadius="5" Grid.Column="0">
                                <Border.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border CornerRadius="5" Background="Black" Width="35" Height="35"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.OpacityMask>
                                <Image Stretch="UniformToFill" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       RenderOptions.BitmapScalingMode="Fant">
                                    <Image.Source>
                                        <BitmapImage UriSource="{Binding Icon, TargetNullValue={StaticResource DefaultAchievementUri}, FallbackValue={StaticResource DefaultAchievementUri}}"
                                                     CreateOptions="IgnoreColorProfile"
                                                     CacheOption="OnLoad"
                                                     DecodePixelHeight="64"/>
                                    </Image.Source>
                                </Image>
                            </Border>
                            <!--<TextBlock Text="{Binding Game.Game.Name, TargetNullValue='Game Name'}" VerticalAlignment="Center"
                            Margin="0,0,10,0"/>-->
                            <StackPanel x:Name="AchievementTexts" Grid.Column="1" VerticalAlignment="Center" MaxHeight="35">
                                <TextBlock x:Name="AchievementTitle" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                />
                                <TextBlock x:Name="Description" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" 
                                FontSize="{DynamicResource FontSizeSmall}" Opacity="0.6"/>
                                <TextBlock x:Name="RecentGameName" Text="{Binding GameInfo.GameName}" FontSize="{DynamicResource FontSizeSmall}" Visibility="Collapsed"/>
                                <TextBlock x:Name="RecentUnlockDate" Text="{Binding UnlockedOn, StringFormat=g}" FontSize="{DynamicResource FontSizeSmall}" Visibility="Collapsed"/>
                            </StackPanel>
                            <ToggleButton x:Name="Toggle" IsChecked="False" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Padding="0" Margin="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Settings.CustomizeRecentIconSize, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"><Setter TargetName="AchievementIcon" Property="Width" Value="{Binding Settings.ArtworkSize, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="AchievementIcon" Property="Height" Value="{Binding Settings.ArtworkSize, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Settings.ShowArtwork, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="False"><Setter TargetName="AchievementIcon" Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding Settings.ShowTitle, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="False"><Setter TargetName="AchievementTitle" Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding Settings.ShowDescription, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="False"><Setter TargetName="Description" Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding Settings.ShowRecentGameName, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"><Setter TargetName="RecentGameName" Property="Visibility" Value="Visible"/><Setter TargetName="AchievementTexts" Property="MaxHeight" Value="120"/></DataTrigger>
                        <DataTrigger Binding="{Binding Settings.ShowRecentExtraDetails, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"><Setter TargetName="RecentUnlockDate" Property="Visibility" Value="Visible"/><Setter TargetName="AchievementTexts" Property="MaxHeight" Value="120"/></DataTrigger>
                        <DataTrigger Binding="{Binding Settings.CustomTextColors, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"><Setter TargetName="AchievementTitle" Property="Foreground" Value="{Binding Settings.TitleColor, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="Description" Property="Foreground" Value="{Binding Settings.DetailColor, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="RecentGameName" Property="Foreground" Value="{Binding Settings.DetailColor, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="RecentUnlockDate" Property="Foreground" Value="{Binding Settings.DetailColor, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Settings.CustomizeRecentTypography, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"><Setter TargetName="AchievementTitle" Property="FontSize" Value="{Binding Settings.TitleSize, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="Description" Property="FontSize" Value="{Binding Settings.DetailSize, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="RecentGameName" Property="FontSize" Value="{Binding Settings.DetailSize, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="RecentUnlockDate" Property="FontSize" Value="{Binding Settings.DetailSize, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="AchievementTexts" Property="MaxHeight" Value="120"/></DataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Settings.CustomizeRecentTypography, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/><Condition Binding="{Binding Settings.Bold, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="AchievementTitle" Property="FontWeight" Value="Bold"/></MultiDataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Settings.CustomizeRecentTypography, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/><Condition Binding="{Binding Settings.Italic, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="AchievementTitle" Property="FontStyle" Value="Italic"/></MultiDataTrigger>

<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Settings.CustomizeRecentTypography, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/><Condition Binding="{Binding Settings.DetailBold, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="Description" Property="FontWeight" Value="Bold"/><Setter TargetName="RecentGameName" Property="FontWeight" Value="Bold"/><Setter TargetName="RecentUnlockDate" Property="FontWeight" Value="Bold"/></MultiDataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Settings.CustomizeRecentTypography, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/><Condition Binding="{Binding Settings.DetailItalic, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="Description" Property="FontStyle" Value="Italic"/><Setter TargetName="RecentGameName" Property="FontStyle" Value="Italic"/><Setter TargetName="RecentUnlockDate" Property="FontStyle" Value="Italic"/></MultiDataTrigger>
<DataTrigger Binding="{Binding Settings.TextStyles[Description].UseDefaults, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="False"><Setter TargetName="Description" Property="FontWeight" Value="{Binding Settings.TextStyles[Description].FontWeight, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="Description" Property="FontStyle" Value="{Binding Settings.TextStyles[Description].FontStyle, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="Description" Property="FontSize" Value="{Binding Settings.TextStyles[Description].Size, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="AchievementTexts" Property="MaxHeight" Value="120"/></DataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Settings.TextStyles[Description].UseDefaults, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="False"/><Condition Binding="{Binding Settings.TextStyles[Description].UseCustomColor, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="Description" Property="Foreground" Value="{Binding Settings.TextStyles[Description].Color, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/></MultiDataTrigger>
<DataTrigger Binding="{Binding Settings.TextStyles[GameName].UseDefaults, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="False"><Setter TargetName="RecentGameName" Property="FontWeight" Value="{Binding Settings.TextStyles[GameName].FontWeight, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="RecentGameName" Property="FontStyle" Value="{Binding Settings.TextStyles[GameName].FontStyle, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="RecentGameName" Property="FontSize" Value="{Binding Settings.TextStyles[GameName].Size, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="AchievementTexts" Property="MaxHeight" Value="120"/></DataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Settings.TextStyles[GameName].UseDefaults, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="False"/><Condition Binding="{Binding Settings.TextStyles[GameName].UseCustomColor, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="RecentGameName" Property="Foreground" Value="{Binding Settings.TextStyles[GameName].Color, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/></MultiDataTrigger>
<DataTrigger Binding="{Binding Settings.TextStyles[UnlockDate].UseDefaults, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="False"><Setter TargetName="RecentUnlockDate" Property="FontWeight" Value="{Binding Settings.TextStyles[UnlockDate].FontWeight, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="RecentUnlockDate" Property="FontStyle" Value="{Binding Settings.TextStyles[UnlockDate].FontStyle, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="RecentUnlockDate" Property="FontSize" Value="{Binding Settings.TextStyles[UnlockDate].Size, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/><Setter TargetName="AchievementTexts" Property="MaxHeight" Value="120"/></DataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Settings.TextStyles[UnlockDate].UseDefaults, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="False"/><Condition Binding="{Binding Settings.TextStyles[UnlockDate].UseCustomColor, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="RecentUnlockDate" Property="Foreground" Value="{Binding Settings.TextStyles[UnlockDate].Color, RelativeSource={RelativeSource AncestorType=local:RecentAchievementsView}}"/></MultiDataTrigger>

                        <Trigger SourceName="Toggle" Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.30" From="35" To="61"
                                                         Storyboard.TargetName="AchievementTexts"
                                                         Storyboard.TargetProperty="MaxHeight"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Description" Storyboard.TargetProperty="TextWrapping">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static TextWrapping.Wrap}"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.30" From="61" To="35"
                                                         Storyboard.TargetName="AchievementTexts"
                                                         Storyboard.TargetProperty="MaxHeight"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Description" Storyboard.TargetProperty="TextWrapping">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.30" Value="{x:Static TextWrapping.NoWrap}"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.15" To="0.25"
                                                         Storyboard.TargetName="ItemBackgroundBrush"
                                                         Storyboard.TargetProperty="Opacity"/>
                                        <DoubleAnimation Duration="0:0:0.15" To="1.05"
                                                         Storyboard.TargetName="ItemScaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"/>
                                        <DoubleAnimation Duration="0:0:0.15" To="1.05"
                                                         Storyboard.TargetName="ItemScaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.15" To="0.15"
                                                         Storyboard.TargetName="ItemBackgroundBrush"
                                                         Storyboard.TargetProperty="Opacity"/>
                                        <DoubleAnimation Duration="0:0:0.15" To="1"
                                                         Storyboard.TargetName="ItemScaleTransform"
                                                         Storyboard.TargetProperty="ScaleX"/>
                                        <DoubleAnimation Duration="0:0:0.15" To="1"
                                                         Storyboard.TargetName="ItemScaleTransform"
                                                         Storyboard.TargetProperty="ScaleY"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
