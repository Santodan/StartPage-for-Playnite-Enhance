<UserControl x:Class="LandingPage.Views.ImageWidgetView" x:Name="ImageRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:LandingPage.Controls">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="ImageVisibility"/></UserControl.Resources>
 <Grid ClipToBounds="True">
  <Button Click="OpenLink_Click" Padding="0" MinWidth="0" MinHeight="0" BorderThickness="0"
          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
          Focusable="{Binding HasLink, ElementName=ImageRoot}">
   <Button.Style>
    <Style TargetType="Button">
     <Setter Property="Background" Value="Transparent"/>
     <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
     </Setter.Value></Setter>
     <Style.Triggers>
      <DataTrigger Binding="{Binding HasLink, ElementName=ImageRoot}" Value="True">
       <Setter Property="Cursor" Value="Hand"/>
       <Setter Property="ToolTip" Value="{Binding Settings.Link, ElementName=ImageRoot}"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </Button.Style>
   <Grid>
    <Image x:Name="WidgetImage" Source="{Binding ImageSource, ElementName=ImageRoot}"
           Stretch="{Binding Settings.Stretch, ElementName=ImageRoot}"
           Opacity="{Binding Settings.Opacity, ElementName=ImageRoot}"/>
    <!-- GIFs and videos: shared media player (pauses when hidden or inactive, releases media when unloaded). -->
    <controls:BackgroundMediaArtwork x:Name="WidgetMedia" Visibility="Collapsed"/>
   </Grid>
  </Button>
  <TextBlock Text="{Binding Status, ElementName=ImageRoot}" TextWrapping="Wrap" TextAlignment="Center"
             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False"
             Foreground="{DynamicResource TextBrush}" Style="{DynamicResource BaseTextBlockStyle}"/>
 </Grid>
</UserControl>
