<UserControl x:Class="LandingPage.Views.PanelAppearanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LandingPage.Controls"
    xmlns:settingsViews="clr-namespace:LandingPage.Views.Settings"
    xmlns:local="clr-namespace:LandingPage.Views"
    xmlns:numeric="http://gu.se/NumericInput">
                                    <ScrollViewer  VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="SettingsSections" Margin="16">
                                            <Expander x:Name="PanelLayoutSection" Header="Panel layout" Visibility="Collapsed" IsExpanded="False" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <StackPanel Margin="8,6,0,8">
                                                    <TextBlock Text="Give each column its own height divider, or each row its own width divider. Then drag the divider inside that column or row. Available for aligned groups of panels." TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                                                    <Button Content="Make column heights independent" Command="{Binding IndependentColumnHeightsCommand}" Click="IndependentLayout_Click" Margin="0,8,0,4"/>
                                                    <Button Content="Make row widths independent" Command="{Binding IndependentRowWidthsCommand}" Click="IndependentLayout_Click"/>
                                                </StackPanel>
                                            </Expander>
                                            <Expander x:Name="ProviderSettingsSection" Header="Widget settings" IsExpanded="True" Visibility="Collapsed" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <ContentControl x:Name="ProviderSettingsHost" HorizontalContentAlignment="Stretch"/>
                                            </Expander>
                                            <Expander Header="Shortcut settings" IsExpanded="True" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GridNode.ViewProperties.ViewId}" Value="ShortcutWidget"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                                                <StackPanel><settingsViews:ShortcutWidgetSettingsView DataContext="{Binding GridNode.ViewProperties.ShortcutSettings}"/><Button Content="Reset shortcut settings" Click="ResetShortcuts_Click" Margin="0,8,0,0"/></StackPanel>
                                            </Expander>
                                            <Expander Header="Achievement widget settings" IsExpanded="True" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GridNode.ViewProperties.IsAchievementWidget}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                                                <settingsViews:AchievementWidgetSettingsView DataContext="{Binding GridNode.ViewProperties.AchievementSettings}" WidgetId="{Binding DataContext.GridNode.ViewProperties.ViewId, RelativeSource={RelativeSource AncestorType=local:PanelAppearanceView}}"/>
                                            </Expander>
                                            <Expander Header="Library chart settings" IsExpanded="True" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GridNode.ViewProperties.ViewId}" Value="LibraryChart"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                                                <StackPanel><settingsViews:LibraryStatisticsSettingsView ChartOnly="True" DataContext="{Binding GridNode.ViewProperties.LibraryStatisticsSettings}"/><Button Content="Reset library chart settings" Click="ResetLibraryStatistics_Click" Margin="0,8,0,0"/></StackPanel>
                                            </Expander>
                                            <Expander Header="Library statistics settings" IsExpanded="True" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GridNode.ViewProperties.ViewId}" Value="LibraryStatistics"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                                                <StackPanel><settingsViews:LibraryStatisticsSettingsView DataContext="{Binding GridNode.ViewProperties.LibraryStatisticsSettings}"/><Button Content="Reset library statistics settings" Click="ResetLibraryStatistics_Click" Margin="0,8,0,0"/></StackPanel>
                                            </Expander>
                                            <Expander Header="Game detail settings" IsExpanded="True" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding GridNode.ViewProperties.IsGameDetailWidget}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style></Expander.Style>
                                                <StackPanel>
                                                    <settingsViews:GameDetailSettingsView DataContext="{Binding GridNode.ViewProperties.GameDetailSettings}" WidgetId="{Binding DataContext.GridNode.ViewProperties.ViewId, RelativeSource={RelativeSource AncestorType=local:PanelAppearanceView}}"/>
                                                    <Button Content="Reset game detail settings" Click="ResetGameDetail_Click" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Expander>
                                            <Expander Header="Featured game settings" IsExpanded="True" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding GridNode.ViewProperties.ViewId}" Value="FeaturedGame"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style></Expander.Style>
                                                <StackPanel><settingsViews:FeaturedGameSettingsView DataContext="{Binding GridNode.ViewProperties.FeaturedGameSettings}"/>
                                                <Button Content="Reset featured game settings" Click="ResetFeaturedGame_Click" Margin="0,8,0,0"/></StackPanel>
                                            </Expander>
                                            <Expander Header="Toolbar settings" IsExpanded="True" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <Expander.Style>
                                                    <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding GridNode.ViewProperties.ViewId}" Value="ToolbarWidget"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Expander.Style>
                                                <StackPanel>
                                                    <settingsViews:ToolbarSettingsView DataContext="{Binding GridNode.ViewProperties.ToolbarSettings}"/>
                                                    <Button Content="Reset toolbar settings" Click="ResetToolbar_Click" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Expander>
                                            <Expander IsExpanded="True" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <Expander.Header>
                                                    <TextBlock Text="Image settings" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}"/>
                                                </Expander.Header>
                                                <Expander.Style>
                                                    <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding GridNode.ViewProperties.ViewId}" Value="ImageWidget">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Expander.Style>
                                                <StackPanel>
                                                    <settingsViews:ImageWidgetSettingsView DataContext="{Binding GridNode.ViewProperties.ImageSettings}"/>
                                                    <Button Content="Reset image settings" Click="ResetImage_Click" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Expander>
                                            <Expander IsExpanded="True" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <Expander.Header>
                                                    <TextBlock Text="Text settings" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}"/>
                                                </Expander.Header>
                                                <Expander.Style>
                                                    <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding GridNode.ViewProperties.ViewId}" Value="TextWidget">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Expander.Style>
                                                <StackPanel>
                                                    <settingsViews:TextWidgetSettingsView DataContext="{Binding GridNode.ViewProperties.TextSettings}"/>
                                                    <Button Content="Reset text settings" Click="ResetText_Click" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Expander>
                                            <Expander IsExpanded="True" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <Expander.Header>
                                                    <TextBlock Text="Clock settings" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}"/>
                                                </Expander.Header>
                                                <Expander.Style>
                                                    <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding GridNode.ViewProperties.ViewId}" Value="DigitalClock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Expander.Style>
                                                <StackPanel>
                                                    <settingsViews:ClockSettingsView DataContext="{Binding GridNode.ViewProperties.ClockSettings}"/>
                                                    <Button Content="Reset clock settings" Click="ResetClock_Click" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Expander>
                                            <Expander x:Name="GeneralAppearanceSection" IsExpanded="True" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}">
                                                <Expander.Header>
                                                    <TextBlock Text="Appearance settings" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}"/>
                                                </Expander.Header>
                                                <StackPanel Margin="0,8,0,0">
                                            <CheckBox Content="Use custom appearance" IsChecked="{Binding GridNode.ViewProperties.Appearance.Enabled}"/>
                                            <CheckBox Content="Show title" IsChecked="{Binding GridNode.ViewProperties.ShowLabel}" Margin="0,6,0,0"/>
                                            <TextBlock Text="Custom title (blank = widget name)" Margin="0,6,0,0"/>
                                            <TextBox Text="{Binding GridNode.ViewProperties.Appearance.Title, UpdateSourceTrigger=PropertyChanged}"/>
<Expander Header="Colors" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,6"><UniformGrid Columns="3" Margin="8,6,0,8">
    <controls:PopupColorPicker Label="Background" SelectedColor="{Binding GridNode.ViewProperties.Appearance.Background, Mode=TwoWay}" ShowCustomColorOption="False" Margin="0,4,8,4"/>
    <controls:PopupColorPicker Label="Border" SelectedColor="{Binding GridNode.ViewProperties.Appearance.BorderColor, Mode=TwoWay}" ShowCustomColorOption="False" Margin="0,4,8,4"/>
    <controls:PopupColorPicker Label="Title" SelectedColor="{Binding GridNode.ViewProperties.Appearance.TitleColor, Mode=TwoWay}" ShowCustomColorOption="False" Margin="0,4,8,4"/>
    <controls:PopupColorPicker Label="Text" SelectedColor="{Binding GridNode.ViewProperties.Appearance.TextColor, Mode=TwoWay}" UseCustomColor="{Binding GridNode.ViewProperties.Appearance.CustomizeText, Mode=TwoWay}" Margin="0,4,8,4"/>
    <controls:PopupColorPicker Label="Icons" SelectedColor="{Binding GridNode.ViewProperties.Appearance.IconColor, Mode=TwoWay}" UseCustomColor="{Binding GridNode.ViewProperties.Appearance.CustomizeIcons, Mode=TwoWay}" Margin="0,4,8,4"/>
    <controls:PopupColorPicker Label="Chart" SelectedColor="{Binding GridNode.ViewProperties.Appearance.ChartColor, Mode=TwoWay}" UseCustomColor="{Binding GridNode.ViewProperties.Appearance.CustomizeCharts, Mode=TwoWay}" Margin="0,4,8,4"/>
    <controls:PopupColorPicker Label="Highlight" SelectedColor="{Binding GridNode.ViewProperties.Appearance.HighlightColor, Mode=TwoWay}" UseCustomColor="{Binding GridNode.ViewProperties.Appearance.CustomizeHighlights, Mode=TwoWay}" Margin="0,4,8,4"/>
</UniformGrid></Expander>
                                            <TextBlock Text="Background opacity" Margin="0,6,0,0"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                                <Slider Value="{Binding GridNode.ViewProperties.Appearance.BackgroundOpacity}" Minimum="0" Maximum="1"
                                                        TickFrequency="0.01" SmallChange="0.01" LargeChange="0.1" IsSnapToTickEnabled="True" AutoToolTipPrecision="2" AutoToolTipPlacement="TopLeft"/>
                                                <numeric:DoubleBox Grid.Column="1" Value="{Binding GridNode.ViewProperties.Appearance.BackgroundOpacity, UpdateSourceTrigger=PropertyChanged}"
                                                                   MinValue="0" MaxValue="1" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/>
                                            </Grid>
                                            <TextBlock Text="Border width" Margin="0,6,0,0"/>
                                            <Slider Value="{Binding GridNode.ViewProperties.Appearance.BorderWidth}" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
                                            <TextBlock Text="Corner radius" Margin="0,6,0,0"/>
                                            <Slider Value="{Binding GridNode.ViewProperties.Appearance.CornerRadius}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
                                            <TextBlock Text="Internal padding" Margin="0,6,0,0"/>
                                            <Slider Value="{Binding GridNode.ViewProperties.Appearance.Padding}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
                                            <TextBlock Text="Outer spacing" Margin="0,6,0,0"/>
                                            <Slider Value="{Binding GridNode.ViewProperties.Appearance.Margin}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
                                            <TextBlock Text="Title size" Margin="0,6,0,0"/>
                                            <Slider Value="{Binding GridNode.ViewProperties.Appearance.TitleSize}" Minimum="8" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
                                            <TextBlock Text="Title alignment" Margin="0,6,0,0"/>
                                            <ComboBox SelectedValue="{Binding GridNode.ViewProperties.Appearance.TitleAlignment}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="Left" Tag="{x:Static TextAlignment.Left}"/>
                                                <ComboBoxItem Content="Center" Tag="{x:Static TextAlignment.Center}"/>
                                                <ComboBoxItem Content="Right" Tag="{x:Static TextAlignment.Right}"/>
                                            </ComboBox>
                                            <CheckBox Content="Shadow" IsChecked="{Binding GridNode.ViewProperties.Appearance.Shadow}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Expander>
                                            <Button Content="Done" Click="Done_Click" Margin="0,12,0,0" Padding="8,4"/>
                                            <Button Content="Reset appearance to theme defaults" Click="ResetAppearance_Click" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </ScrollViewer>
</UserControl>
