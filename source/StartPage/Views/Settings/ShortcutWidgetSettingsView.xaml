<UserControl x:Class="LandingPage.Views.Settings.ShortcutWidgetSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{DynamicResource TextBrush}"
 xmlns:controls="clr-namespace:LandingPage.Controls" xmlns:settings="clr-namespace:LandingPage.Settings" xmlns:numeric="http://gu.se/NumericInput">
 <StackPanel Margin="0,8">
  <StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,6,0,3"/></Style></StackPanel.Resources>
  <Expander Header="Shortcuts" IsExpanded="True" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,6">
   <TextBlock Text="Select a shortcut to edit"/>
   <ComboBox x:Name="EntrySelector" ItemsSource="{Binding Items}" DisplayMemberPath="DisplayName" SelectionChanged="Selection_Changed"/>
   <WrapPanel Margin="0,6,0,6"><Button Content="Add shortcut" Click="Add_Click" Margin="0,0,6,4"/><Button x:Name="DuplicateButton" Content="Duplicate" Click="Duplicate_Click" Margin="0,0,6,4"/><Button x:Name="RemoveButton" Content="Remove" Click="Remove_Click" Margin="0,0,6,4"/><Button x:Name="UpButton" Content="&#x2191;" ToolTip="Move up" Click="Up_Click" Margin="0,0,6,4"/><Button x:Name="DownButton" Content="&#x2193;" ToolTip="Move down" Click="Down_Click"/></WrapPanel>
   <StackPanel x:Name="EntryEditor" DataContext="{Binding SelectedItem,ElementName=EntrySelector}">
    <CheckBox Content="Enable shortcut" IsChecked="{Binding Enabled}" Foreground="{DynamicResource TextBrush}"/>
    <TextBlock Text="Type"/><ComboBox x:Name="KindSelector" SelectedItem="{Binding Kind,Mode=TwoWay}"/>
    <TextBlock Text="Label (blank = game name or target)"/><TextBox Text="{Binding Label,UpdateSourceTrigger=PropertyChanged}"/>
    <StackPanel x:Name="GameFields"><Button Content="Choose game..." Click="ChooseGame_Click" Margin="0,6,0,0"/><TextBlock Text="{Binding Target}" TextWrapping="Wrap"/></StackPanel>
    <StackPanel x:Name="TargetFields"><TextBlock Text="Target (website or absolute path)"/><TextBox Text="{Binding Target,UpdateSourceTrigger=PropertyChanged}"/><Button x:Name="BrowseTargetButton" Content="Browse..." Click="BrowseTarget_Click" Margin="0,6,0,0"/></StackPanel>
    <StackPanel x:Name="ApplicationFields"><TextBlock Text="Arguments (optional)"/><TextBox Text="{Binding Arguments,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Working directory (blank = application folder)"/><TextBox Text="{Binding WorkingDirectory,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Choose working directory..." Click="WorkingDirectory_Click" Margin="0,6,0,0"/></StackPanel>
    <TextBlock Text="Custom icon (blank = automatic game, application, Windows folder or website icon)"/><TextBox Text="{Binding IconPath,UpdateSourceTrigger=PropertyChanged}"/>
    <WrapPanel><Button Content="Choose icon..." Click="Icon_Click" Margin="0,6,6,0"/><Button Content="Use default icon" Click="ClearIcon_Click" Margin="0,6,0,0"/></WrapPanel>
   </StackPanel>
  </StackPanel></Expander>
  <Expander Header="Layout" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,6">
   <TextBlock Text="Layout"/><ComboBox x:Name="LayoutSelector" SelectedItem="{Binding Layout,Mode=TwoWay}"/>
   <TextBlock Text="Alignment"/><ComboBox SelectedValue="{Binding Alignment}" SelectedValuePath="Tag"><ComboBoxItem Content="Left" Tag="{x:Static HorizontalAlignment.Left}"/><ComboBoxItem Content="Center" Tag="{x:Static HorizontalAlignment.Center}"/><ComboBoxItem Content="Right" Tag="{x:Static HorizontalAlignment.Right}"/></ComboBox>
   <CheckBox Foreground="{DynamicResource TextBrush}" Content="Show icons" IsChecked="{Binding ShowIcons}"/><CheckBox Foreground="{DynamicResource TextBrush}" Content="Show labels" IsChecked="{Binding ShowLabels}"/><CheckBox Foreground="{DynamicResource TextBrush}" Content="Place icons above labels" IsChecked="{Binding IconAbove}"/>
   <UniformGrid Columns="2">
    <StackPanel Margin="0,0,8,4"><TextBlock Text="Icon size"/><numeric:DoubleBox Value="{Binding IconSize}" MinValue="12" MaxValue="256" Style="{StaticResource {x:Type TextBox}}"/></StackPanel>
    <StackPanel Margin="0,0,8,4"><TextBlock Text="Button width (0 = automatic)"/><numeric:DoubleBox Value="{Binding ButtonWidth}" MinValue="0" MaxValue="1000" Style="{StaticResource {x:Type TextBox}}"/></StackPanel>
    <StackPanel Margin="0,0,8,4"><TextBlock Text="Spacing"/><numeric:DoubleBox Value="{Binding Spacing}" MinValue="0" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></StackPanel>
    <StackPanel Margin="0,0,8,4"><TextBlock Text="Padding"/><numeric:DoubleBox Value="{Binding Padding}" MinValue="0" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></StackPanel>
    <StackPanel Margin="0,0,8,4"><TextBlock Text="Corner radius" ToolTip="Applies when custom button background or border is enabled."/><numeric:DoubleBox Value="{Binding CornerRadius}" MinValue="0" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></StackPanel>
    <StackPanel Margin="0,0,8,4"><TextBlock Text="Border width" ToolTip="Applies when custom button background or border is enabled."/><numeric:DoubleBox Value="{Binding BorderWidth}" MinValue="0" MaxValue="20" Style="{StaticResource {x:Type TextBox}}"/></StackPanel>
   </UniformGrid>
  </StackPanel></Expander>
  <Expander Header="Text formatting" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,6">
   <TextBlock Text="Label size and style"/>
   <WrapPanel><numeric:DoubleBox Width="64" Value="{Binding FontSize}" MinValue="8" MaxValue="100" Style="{StaticResource {x:Type TextBox}}" VerticalAlignment="Center"/><ToggleButton Content="B" FontWeight="Bold" ToolTip="Bold" IsChecked="{Binding Bold}" Width="32" Height="28" Margin="4,0"/><ToggleButton Content="I" FontStyle="Italic" ToolTip="Italic" IsChecked="{Binding Italic}" Width="32" Height="28" Margin="0,0,4,0"/><controls:PopupColorPicker Label="Color" SelectedColor="{Binding TextColor,Mode=TwoWay}" UseCustomColor="{Binding CustomTextColor,Mode=TwoWay}" VerticalAlignment="Center"/></WrapPanel>
  </StackPanel></Expander>
  <Expander Header="Colors" Foreground="{DynamicResource TextBrush}"><UniformGrid Columns="3" Margin="8,6">
   <controls:PopupColorPicker Label="Button background" Margin="0,4,8,4" SelectedColor="{Binding Background,Mode=TwoWay}" UseCustomColor="{Binding CustomBackground,Mode=TwoWay}"/>
   <controls:PopupColorPicker Label="Button border" Margin="0,4,8,4" SelectedColor="{Binding BorderColor,Mode=TwoWay}" UseCustomColor="{Binding CustomBorder,Mode=TwoWay}"/>
  </UniformGrid></Expander>
  <TextBlock Text="Open shortcuts outside dashboard Edit Mode. Missing targets are disabled and show the reason in a tooltip. Local files and game IDs are referenced in place when exporting profiles." TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
