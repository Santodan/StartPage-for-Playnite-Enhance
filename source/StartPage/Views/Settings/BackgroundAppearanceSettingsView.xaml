<UserControl x:Class="LandingPage.Views.Settings.BackgroundAppearanceSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:LandingPage.Controls" xmlns:settings="clr-namespace:LandingPage.Settings" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:numeric="http://gu.se/NumericInput" Foreground="{DynamicResource TextBrush}">
 <StackPanel Margin="0,8">
  <StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,6,0,3"/></Style></StackPanel.Resources>
  <CheckBox x:Name="ExcludeSidebarToggle" Content="Keep background out of Playnite sidebar" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding ExcludeSidebar}" Margin="0,0,0,8" ToolTip="Leaves the sidebar to the active theme. Dashboard-only backgrounds already stay inside the content area."/>
  <Expander Header="Image framing" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,6">
   <TextBlock Text="Image sizing"/><ComboBox x:Name="FitSelector" SelectedValue="{Binding Fit}" SelectedValuePath="Tag"><ComboBoxItem Content="Fill (crop to cover)" Tag="{x:Static settings:BackgroundFit.Fill}"/><ComboBoxItem Content="Fit (show whole image)" Tag="{x:Static settings:BackgroundFit.Fit}"/><ComboBoxItem Content="Stretch" Tag="{x:Static settings:BackgroundFit.Stretch}"/><ComboBoxItem Content="Original size" Tag="{x:Static settings:BackgroundFit.OriginalSize}"/></ComboBox>
<TextBlock Text="Zoom"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider x:Name="ZoomSlider" Value="{Binding Zoom}" Minimum="1" Maximum="4" TickFrequency="0.05" SmallChange="0.05" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/><numeric:DoubleBox Grid.Column="1" Value="{Binding Zoom}" MinValue="1" MaxValue="4" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid><TextBlock Text="Horizontal position (0 = left, 1 = right)"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding PositionX}" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/><numeric:DoubleBox Grid.Column="1" Value="{Binding PositionX}" MinValue="0" MaxValue="1" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid><TextBlock Text="Vertical position (0 = top, 1 = bottom)"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding PositionY}" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/><numeric:DoubleBox Grid.Column="1" Value="{Binding PositionY}" MinValue="0" MaxValue="1" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid><TextBlock Text="Image opacity"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding ImageOpacity}" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/><numeric:DoubleBox Grid.Column="1" Value="{Binding ImageOpacity}" MinValue="0" MaxValue="1" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid>   <WrapPanel><CheckBox Content="Flip horizontally" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding FlipHorizontal}" Margin="0,6,12,0"/><CheckBox Content="Flip vertically" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding FlipVertical}" Margin="0,6,0,0"/></WrapPanel>
  </StackPanel></Expander>
  <Expander Header="Background effects" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,6">
   <TextBlock Text="Enable base and tint colors in Colors. Fade and vignette strength can be set independently." TextWrapping="Wrap"/>
<TextBlock Text="Tint opacity"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding TintOpacity}" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/><numeric:DoubleBox Grid.Column="1" Value="{Binding TintOpacity}" MinValue="0" MaxValue="1" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid>   <TextBlock Text="Fade toward edge"/><ComboBox SelectedValue="{Binding Fade}" SelectedValuePath="Tag"><ComboBoxItem Content="None" Tag="{x:Static settings:BackgroundFade.None}"/><ComboBoxItem Content="Top" Tag="{x:Static settings:BackgroundFade.Top}"/><ComboBoxItem Content="Bottom" Tag="{x:Static settings:BackgroundFade.Bottom}"/><ComboBoxItem Content="Left" Tag="{x:Static settings:BackgroundFade.Left}"/><ComboBoxItem Content="Right" Tag="{x:Static settings:BackgroundFade.Right}"/></ComboBox>
<TextBlock Text="Edge fade strength"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding FadeOpacity}" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/><numeric:DoubleBox Grid.Column="1" Value="{Binding FadeOpacity}" MinValue="0" MaxValue="1" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid><TextBlock Text="Vignette strength"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding Vignette}" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/><numeric:DoubleBox Grid.Column="1" Value="{Binding Vignette}" MinValue="0" MaxValue="1" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid>  </StackPanel></Expander>
  <Expander Header="GIF / video playback" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,6">
   <CheckBox Content="Play animated backgrounds" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding PlayMedia}"/>
   <CheckBox Content="Loop GIFs and videos" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding LoopMedia}"/>
   <CheckBox Content="Pause when Playnite loses focus" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding PauseMediaWhenInactive}"/>
   <TextBlock Text="Playback speed"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding PlaybackSpeed}" Minimum="0.25" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/><numeric:DoubleBox Grid.Column="1" Value="{Binding PlaybackSpeed}" MinValue="0.25" MaxValue="2" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid>
   <CheckBox Content="Mute video" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding VideoMuted}" Margin="0,6,0,0"/>
   <TextBlock Text="Video volume"/><Slider Value="{Binding VideoVolume}" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
   <TextBlock Text="GIF frame-rate limit"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding GifFrameRate}" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/><numeric:IntBox Grid.Column="1" Value="{Binding GifFrameRate}" MinValue="1" MaxValue="60" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid>
   <TextBlock Text="GIF maximum decoded dimension"/><ComboBox SelectedValue="{Binding GifMaxDimension}" SelectedValuePath="Tag"><ComboBoxItem Content="Original resolution"><ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="1280 pixels"><ComboBoxItem.Tag><sys:Int32>1280</sys:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="1920 pixels (default)"><ComboBoxItem.Tag><sys:Int32>1920</sys:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="2560 pixels"><ComboBoxItem.Tag><sys:Int32>2560</sys:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="3840 pixels"><ComboBoxItem.Tag><sys:Int32>3840</sys:Int32></ComboBoxItem.Tag></ComboBoxItem></ComboBox>
   <TextBlock Text="Hidden backgrounds stop decoding. Lower GIF resolution/frame rate reduces CPU and memory use. Videos use installed Windows codecs; MP4/H.264 is a practical starting point. Video playback defaults to muted." TextWrapping="Wrap"/>
   <Button Content="Restart animated background" Click="RestartMedia_Click" Margin="0,8,0,0"/>
  </StackPanel></Expander>
  <Expander Header="Colors" Foreground="{DynamicResource TextBrush}"><UniformGrid Columns="3" Margin="8,6">
   <controls:PopupColorPicker Label="Base" SelectedColor="{Binding BaseColor,Mode=TwoWay}" UseCustomColor="{Binding UseBaseColor,Mode=TwoWay}" Margin="0,4,8,4"/>
   <controls:PopupColorPicker Label="Tint" SelectedColor="{Binding TintColor,Mode=TwoWay}" UseCustomColor="{Binding TintEnabled,Mode=TwoWay}" Margin="0,4,8,4"/>
   <controls:PopupColorPicker Label="Edge fade" SelectedColor="{Binding FadeColor,Mode=TwoWay}" ShowCustomColorOption="False" Margin="0,4,8,4"/>
   <controls:PopupColorPicker Label="Vignette" SelectedColor="{Binding VignetteColor,Mode=TwoWay}" ShowCustomColorOption="False" Margin="0,4,8,4"/>
  </UniformGrid></Expander>
  <Button Content="Reset background appearance and playback" Click="Reset_Click" Margin="0,8,0,0"/>
 </StackPanel>
</UserControl>
