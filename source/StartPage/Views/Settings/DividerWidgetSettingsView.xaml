<UserControl x:Class="LandingPage.Views.Settings.DividerWidgetSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:LandingPage.Controls" xmlns:settings="clr-namespace:LandingPage.Settings" xmlns:numeric="http://gu.se/NumericInput" Foreground="{DynamicResource TextBrush}">
 <StackPanel Margin="0,8">
  <StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,6,0,3"/></Style></StackPanel.Resources>
  <TextBlock Text="Mode"/><ComboBox SelectedValue="{Binding Mode}" SelectedValuePath="Tag"><ComboBoxItem Content="Decorative divider" Tag="{x:Static settings:DividerMode.Divider}"/><ComboBoxItem Content="Empty spacer" Tag="{x:Static settings:DividerMode.Spacer}"/></ComboBox>
  <TextBlock Text="Orientation"/><ComboBox SelectedValue="{Binding Orientation}" SelectedValuePath="Tag"><ComboBoxItem Content="Horizontal" Tag="{x:Static Orientation.Horizontal}"/><ComboBoxItem Content="Vertical" Tag="{x:Static Orientation.Vertical}"/></ComboBox>
  <TextBlock Text="Preferred spacing (auto-sized panels)"/><numeric:DoubleBox Value="{Binding SpaceSize,UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="1000" Style="{StaticResource {x:Type TextBox}}"/>
  <TextBlock Text="In split dashboard panels, drag the panel divider to set the space occupied by this widget. Preferred spacing is used when the panel sizes to its content." TextWrapping="Wrap"/>
  <Expander Header="Divider appearance" IsExpanded="True" Foreground="{DynamicResource TextBrush}">
   <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="{x:Static settings:DividerMode.Spacer}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style>
   <StackPanel Margin="8,6">
    <TextBlock Text="Divider type"/><ComboBox x:Name="DecorationSelector" SelectedValue="{Binding Decoration}" SelectedValuePath="Tag"><ComboBoxItem Content="Line" Tag="{x:Static settings:DividerDecoration.Line}"/><ComboBoxItem Content="Double line" Tag="{x:Static settings:DividerDecoration.DoubleLine}"/><ComboBoxItem Content="Triple line" Tag="{x:Static settings:DividerDecoration.TripleLine}"/><ComboBoxItem Content="Wave" Tag="{x:Static settings:DividerDecoration.Wave}"/><ComboBoxItem Content="Double wave" Tag="{x:Static settings:DividerDecoration.DoubleWave}"/><ComboBoxItem Content="Zigzag" Tag="{x:Static settings:DividerDecoration.Zigzag}"/><ComboBoxItem Content="Chevrons" Tag="{x:Static settings:DividerDecoration.Chevrons}"/><ComboBoxItem Content="Circles" Tag="{x:Static settings:DividerDecoration.Circles}"/><ComboBoxItem Content="Squares" Tag="{x:Static settings:DividerDecoration.Squares}"/><ComboBoxItem Content="Diamonds" Tag="{x:Static settings:DividerDecoration.Diamonds}"/></ComboBox>
    <TextBlock Text="Stroke style"/><ComboBox SelectedValue="{Binding LineStyle}" SelectedValuePath="Tag"><ComboBoxItem Content="Solid" Tag="{x:Static settings:DividerLineStyle.Solid}"/><ComboBoxItem Content="Dashed" Tag="{x:Static settings:DividerLineStyle.Dashed}"/><ComboBoxItem Content="Dotted" Tag="{x:Static settings:DividerLineStyle.Dotted}"/><ComboBoxItem Content="Dash-dot" Tag="{x:Static settings:DividerLineStyle.DashDot}"/><ComboBoxItem Content="Dash-dot-dot" Tag="{x:Static settings:DividerLineStyle.DashDotDot}"/><ComboBoxItem Content="Custom dashes" Tag="{x:Static settings:DividerLineStyle.Custom}"/></ComboBox>
    <TextBlock Text="Thickness"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider x:Name="ThicknessSlider" Value="{Binding LineThickness}" Minimum="0.5" Maximum="30" TickFrequency=".5" SmallChange=".5" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"/><numeric:DoubleBox Grid.Column="1" Value="{Binding LineThickness}" MinValue="0.5" MaxValue="30" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid>
    <CheckBox Content="Rounded line ends" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding RoundCaps}"/>
    <Expander Header="Pattern settings" Foreground="{DynamicResource TextBrush}"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers><DataTrigger Binding="{Binding Decoration}" Value="{x:Static settings:DividerDecoration.Line}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style><StackPanel Margin="8,6"><TextBlock Text="Pattern height / shape size"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding PatternSize}" Minimum="1" Maximum="100" TickFrequency="1" SmallChange="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"/><numeric:DoubleBox Grid.Column="1" Value="{Binding PatternSize}" MinValue="1" MaxValue="100" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid><TextBlock Text="Pattern spacing"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding PatternSpacing}" Minimum="4" Maximum="200" TickFrequency="1" SmallChange="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"/><numeric:DoubleBox Grid.Column="1" Value="{Binding PatternSpacing}" MinValue="4" MaxValue="200" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid><CheckBox Content="Fill repeating shapes" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding FillShapes}"><CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Decoration}" Value="{x:Static settings:DividerDecoration.Circles}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Decoration}" Value="{x:Static settings:DividerDecoration.Squares}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Decoration}" Value="{x:Static settings:DividerDecoration.Diamonds}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox></StackPanel></Expander>
    <Expander Header="Custom dash pattern" Foreground="{DynamicResource TextBrush}"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LineStyle}" Value="{x:Static settings:DividerLineStyle.Custom}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style><StackPanel Margin="8,6"><TextBlock Text="Dash length"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding DashLength}" Minimum="0.5" Maximum="100" TickFrequency=".5" SmallChange=".5" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"/><numeric:DoubleBox Grid.Column="1" Value="{Binding DashLength}" MinValue="0.5" MaxValue="100" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid><TextBlock Text="Gap length"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding DashGap}" Minimum="0.5" Maximum="100" TickFrequency=".5" SmallChange=".5" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"/><numeric:DoubleBox Grid.Column="1" Value="{Binding DashGap}" MinValue="0.5" MaxValue="100" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid></StackPanel></Expander>
    <TextBlock Text="Inset at both ends"/><numeric:DoubleBox Value="{Binding Inset}" MinValue="0" MaxValue="1000" Style="{StaticResource {x:Type TextBox}}"/>
    <TextBlock Text="Length (%)"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider Value="{Binding Length}" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/><numeric:DoubleBox Grid.Column="1" Value="{Binding Length}" MinValue="1" MaxValue="100" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid>
    <TextBlock Text="Position (top/bottom for horizontal; left/right for vertical)" TextWrapping="Wrap"/><ComboBox SelectedValue="{Binding Position}" SelectedValuePath="Tag"><ComboBoxItem Content="Start" Tag="{x:Static settings:DividerPlacement.Start}"/><ComboBoxItem Content="Center" Tag="{x:Static settings:DividerPlacement.Center}"/><ComboBoxItem Content="End" Tag="{x:Static settings:DividerPlacement.End}"/></ComboBox>
    <TextBlock Text="Alignment along the line"/><ComboBox SelectedValue="{Binding LengthAlignment}" SelectedValuePath="Tag"><ComboBoxItem Content="Start" Tag="{x:Static settings:DividerPlacement.Start}"/><ComboBoxItem Content="Center" Tag="{x:Static settings:DividerPlacement.Center}"/><ComboBoxItem Content="End" Tag="{x:Static settings:DividerPlacement.End}"/></ComboBox>
    <TextBlock Text="Opacity"/><Slider Value="{Binding LineOpacity}" Minimum="0" Maximum="1" SmallChange="0.01" TickFrequency="0.01" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/>
    <Expander Header="Connections" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,6">
     <CheckBox Content="Connect ends to nearby dividers" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding ConnectEnds}"/>
     <StackPanel IsEnabled="{Binding ConnectEnds}">
      <CheckBox Content="Connect start (left / top)" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding ConnectStart}"/>
      <CheckBox Content="Connect end (right / bottom)" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding ConnectEnd}"/>
      <TextBlock Text="Maximum connection distance"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Value="{Binding ConnectionRange}" Minimum="0" Maximum="1000" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/><numeric:DoubleBox Grid.Column="1" Value="{Binding ConnectionRange}" MinValue="0" MaxValue="1000" Margin="8,0,0,0" Style="{StaticResource {x:Type TextBox}}"/></Grid>
     </StackPanel>
     <TextBlock Text="Copy appearance from"/>
     <ComboBox x:Name="MatchConnectionEnd" SelectedValuePath="Tag" SelectedIndex="0" SelectionChanged="MatchEnd_Changed"><ComboBoxItem Content="Nearest connected divider" Tag="0"/><ComboBoxItem Content="Start (left / top)" Tag="1"/><ComboBoxItem Content="End (right / bottom)" Tag="2"/></ComboBox>
     <Button x:Name="MatchAppearanceButton" Content="Match connected divider's appearance" Click="MatchAppearance_Click" IsEnabled="False" Margin="0,6,0,0" ToolTipService.ShowOnDisabled="True" ToolTip="Enable connections and place another divider within range."/>
     <TextBlock Text="Extends the selected ends across panel spacing to the nearest aligned or crossing divider. Enable it on the vertical divider to join a horizontal divider below. Connections follow the source line's color and style and do not change widget sizes." TextWrapping="Wrap"/>
    </StackPanel></Expander>
    <Expander Header="Colors" Foreground="{DynamicResource TextBrush}"><UniformGrid Columns="3" Margin="8,6"><controls:PopupColorPicker Label="Line" Margin="0,4,8,4" SelectedColor="{Binding Color,Mode=TwoWay}" UseCustomColor="{Binding CustomColor,Mode=TwoWay}"/></UniformGrid></Expander>
   </StackPanel>
  </Expander>
 </StackPanel>
</UserControl>
