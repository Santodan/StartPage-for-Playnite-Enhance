<UserControl x:Class="LandingPage.Views.Settings.DividerWidgetSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:LandingPage.Controls" xmlns:settings="clr-namespace:LandingPage.Settings" xmlns:numeric="http://gu.se/NumericInput" Foreground="{DynamicResource TextBrush}">
 <StackPanel Margin="0,8">
  <StackPanel.Resources><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,6,0,0"/></Style></StackPanel.Resources>
  <controls:SettingsColumns>
   <controls:SettingsField Label="Mode"><ComboBox SelectedValue="{Binding Mode}" SelectedValuePath="Tag"><ComboBoxItem Content="Decorative divider" Tag="{x:Static settings:DividerMode.Divider}"/><ComboBoxItem Content="Empty spacer" Tag="{x:Static settings:DividerMode.Spacer}"/></ComboBox></controls:SettingsField>
   <controls:SettingsField Label="Orientation"><ComboBox SelectedValue="{Binding Orientation}" SelectedValuePath="Tag"><ComboBoxItem Content="Horizontal" Tag="{x:Static Orientation.Horizontal}"/><ComboBoxItem Content="Vertical" Tag="{x:Static Orientation.Vertical}"/></ComboBox></controls:SettingsField>
  </controls:SettingsColumns>
  <controls:SettingsField Label="Preferred spacing (auto-sized panels)">
   <numeric:DoubleBox Value="{Binding SpaceSize,UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="1000" Width="64" HorizontalAlignment="Left" Style="{StaticResource {x:Type TextBox}}"/>
   <controls:SettingsHint Text="In split dashboard panels, drag the panel divider to set the space occupied by this widget. Preferred spacing is used when the panel sizes to its content."/>
  </controls:SettingsField>
  <Expander Header="Divider appearance" IsExpanded="True" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}">
   <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="{x:Static settings:DividerMode.Spacer}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style>
   <StackPanel Margin="8,6">
    <controls:SettingsColumns>
     <controls:SettingsField Label="Divider type"><ComboBox x:Name="DecorationSelector" SelectedValue="{Binding Decoration}" SelectedValuePath="Tag"><ComboBoxItem Content="Line" Tag="{x:Static settings:DividerDecoration.Line}"/><ComboBoxItem Content="Double line" Tag="{x:Static settings:DividerDecoration.DoubleLine}"/><ComboBoxItem Content="Triple line" Tag="{x:Static settings:DividerDecoration.TripleLine}"/><ComboBoxItem Content="Wave" Tag="{x:Static settings:DividerDecoration.Wave}"/><ComboBoxItem Content="Double wave" Tag="{x:Static settings:DividerDecoration.DoubleWave}"/><ComboBoxItem Content="Zigzag" Tag="{x:Static settings:DividerDecoration.Zigzag}"/><ComboBoxItem Content="Chevrons" Tag="{x:Static settings:DividerDecoration.Chevrons}"/><ComboBoxItem Content="Circles" Tag="{x:Static settings:DividerDecoration.Circles}"/><ComboBoxItem Content="Squares" Tag="{x:Static settings:DividerDecoration.Squares}"/><ComboBoxItem Content="Diamonds" Tag="{x:Static settings:DividerDecoration.Diamonds}"/></ComboBox></controls:SettingsField>
     <controls:SettingsField Label="Stroke style"><ComboBox SelectedValue="{Binding LineStyle}" SelectedValuePath="Tag"><ComboBoxItem Content="Solid" Tag="{x:Static settings:DividerLineStyle.Solid}"/><ComboBoxItem Content="Dashed" Tag="{x:Static settings:DividerLineStyle.Dashed}"/><ComboBoxItem Content="Dotted" Tag="{x:Static settings:DividerLineStyle.Dotted}"/><ComboBoxItem Content="Dash-dot" Tag="{x:Static settings:DividerLineStyle.DashDot}"/><ComboBoxItem Content="Dash-dot-dot" Tag="{x:Static settings:DividerLineStyle.DashDotDot}"/><ComboBoxItem Content="Custom dashes" Tag="{x:Static settings:DividerLineStyle.Custom}"/></ComboBox></controls:SettingsField>
    </controls:SettingsColumns>
    <controls:SettingsSlider x:Name="ThicknessSlider" Label="Thickness" Value="{Binding LineThickness}" Minimum="0.5" Maximum="30" Step="0.5" Precision="1"/>
    <controls:SettingsSlider x:Name="OpacitySlider" Label="Opacity" Value="{Binding LineOpacity}" Minimum="0" Maximum="1" Step="0.01" Precision="2"/>
    <CheckBox Content="Rounded line ends" IsChecked="{Binding RoundCaps}"/>
    <Expander Header="Pattern settings" Margin="0,6,0,0" Foreground="{DynamicResource TextBrush}"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers><DataTrigger Binding="{Binding Decoration}" Value="{x:Static settings:DividerDecoration.Line}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style>
     <StackPanel Margin="8,6">
      <controls:SettingsSlider Label="Pattern height / shape size" Value="{Binding PatternSize}" Minimum="1" Maximum="100" Step="1" Precision="1"/>
      <controls:SettingsSlider Label="Pattern spacing" Value="{Binding PatternSpacing}" Minimum="4" Maximum="200" Step="1" Precision="1"/>
      <CheckBox Content="Fill repeating shapes" IsChecked="{Binding FillShapes}"><CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,6,0,0"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Decoration}" Value="{x:Static settings:DividerDecoration.Circles}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Decoration}" Value="{x:Static settings:DividerDecoration.Squares}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Decoration}" Value="{x:Static settings:DividerDecoration.Diamonds}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox>
     </StackPanel>
    </Expander>
    <Expander Header="Custom dash pattern" Margin="0,6,0,0" Foreground="{DynamicResource TextBrush}"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LineStyle}" Value="{x:Static settings:DividerLineStyle.Custom}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
     <StackPanel Margin="8,6">
      <controls:SettingsSlider Label="Dash length" Value="{Binding DashLength}" Minimum="0.5" Maximum="100" Step="0.5" Precision="1"/>
      <controls:SettingsSlider Label="Gap length" Value="{Binding DashGap}" Minimum="0.5" Maximum="100" Step="0.5" Precision="1"/>
     </StackPanel>
    </Expander>
    <controls:SettingsSlider Label="Length (%)" Value="{Binding Length}" Minimum="1" Maximum="100" Step="1" Precision="0"/>
    <controls:SettingsColumns>
     <controls:SettingsField Label="Inset at both ends"><numeric:DoubleBox Value="{Binding Inset}" MinValue="0" MaxValue="1000" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
     <controls:SettingsField Label="Position across panel"><ComboBox SelectedValue="{Binding Position}" SelectedValuePath="Tag"><ComboBoxItem Content="Start" Tag="{x:Static settings:DividerPlacement.Start}"/><ComboBoxItem Content="Center" Tag="{x:Static settings:DividerPlacement.Center}"/><ComboBoxItem Content="End" Tag="{x:Static settings:DividerPlacement.End}"/></ComboBox></controls:SettingsField>
     <controls:SettingsField Label="Alignment along the line"><ComboBox SelectedValue="{Binding LengthAlignment}" SelectedValuePath="Tag"><ComboBoxItem Content="Start" Tag="{x:Static settings:DividerPlacement.Start}"/><ComboBoxItem Content="Center" Tag="{x:Static settings:DividerPlacement.Center}"/><ComboBoxItem Content="End" Tag="{x:Static settings:DividerPlacement.End}"/></ComboBox></controls:SettingsField>
    </controls:SettingsColumns>
    <controls:SettingsHint Text="Position: top/bottom for horizontal dividers, left/right for vertical dividers."/>
    <Expander Header="Connections" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,6">
     <CheckBox Content="Connect ends to nearby dividers" IsChecked="{Binding ConnectEnds}"/>
     <StackPanel IsEnabled="{Binding ConnectEnds}">
      <controls:SettingsColumns>
       <CheckBox Content="Connect start (left / top)" IsChecked="{Binding ConnectStart}"/>
       <CheckBox Content="Connect end (right / bottom)" IsChecked="{Binding ConnectEnd}"/>
      </controls:SettingsColumns>
      <controls:SettingsSlider Label="Maximum connection distance" Value="{Binding ConnectionRange}" Minimum="0" Maximum="1000" Step="1" Precision="0"/>
     </StackPanel>
     <controls:SettingsField Label="Copy appearance from">
      <ComboBox x:Name="MatchConnectionEnd" SelectedValuePath="Tag" SelectedIndex="0" SelectionChanged="MatchEnd_Changed"><ComboBoxItem Content="Nearest connected divider" Tag="0"/><ComboBoxItem Content="Start (left / top)" Tag="1"/><ComboBoxItem Content="End (right / bottom)" Tag="2"/></ComboBox>
     </controls:SettingsField>
     <Button x:Name="MatchAppearanceButton" Content="Match connected divider's appearance" Click="MatchAppearance_Click" IsEnabled="False" Margin="0,6,0,0" ToolTipService.ShowOnDisabled="True" ToolTip="Enable connections and place another divider within range."/>
     <controls:SettingsHint Text="Extends the selected ends across panel spacing to the nearest aligned or crossing divider. Enable it on the vertical divider to join a horizontal divider below. Connections follow the source line's color and style and do not change widget sizes."/>
    </StackPanel></Expander>
    <Expander Header="Colors" Margin="0,6,0,0" Foreground="{DynamicResource TextBrush}"><UniformGrid Columns="3" Margin="8,6"><controls:PopupColorPicker Label="Line" Margin="0,4,8,4" SelectedColor="{Binding Color,Mode=TwoWay}" UseCustomColor="{Binding CustomColor,Mode=TwoWay}"/></UniformGrid></Expander>
   </StackPanel>
  </Expander>
 </StackPanel>
</UserControl>
