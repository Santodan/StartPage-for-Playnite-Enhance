<UserControl x:Class="LandingPage.Views.Settings.LibraryStatisticsSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:numeric="http://gu.se/NumericInput" xmlns:local="clr-namespace:LandingPage.Views.Settings" xmlns:settings="clr-namespace:LandingPage.Settings" xmlns:controls="clr-namespace:LandingPage.Controls" xmlns:sys="clr-namespace:System;assembly=mscorlib">
 <StackPanel Margin="0,8">
  <StackPanel.Resources>
   <local:InverseGlobalColorConverter x:Key="InverseGlobalColor"/>
   <local:StatisticColorLookup x:Key="StatisticColorLookup"/>
   <DataTemplate x:Key="EmptyStatisticColors"><Border/></DataTemplate>
   <DataTemplate x:Key="StatisticColorFields"><UniformGrid Columns="3" Margin="8,4">
    <controls:PopupColorPicker x:Name="StatisticValueColorPicker" Label="Value" Margin="0,4,8,4" SelectedColor="{Binding ValueColor,Mode=TwoWay}" UseCustomColor="{Binding UseGlobalValueColor,Mode=TwoWay,Converter={StaticResource InverseGlobalColor}}"/>
    <controls:PopupColorPicker Label="Label" Margin="0,4,8,4" SelectedColor="{Binding LabelColor,Mode=TwoWay}" UseCustomColor="{Binding UseGlobalLabelColor,Mode=TwoWay,Converter={StaticResource InverseGlobalColor}}"/>
   </UniformGrid></DataTemplate>
   <DataTemplate x:Key="StatisticColorTemplate"><Expander x:Name="StatisticColorsExpander" Header="Colors" Foreground="{DynamicResource TextBrush}" Content="{Binding}" ContentTemplate="{StaticResource EmptyStatisticColors}" Expanded="StatisticColors_Expanded"/></DataTemplate>
   <Style x:Key="StatisticColorEditor" TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource StatisticColorTemplate}"/><Setter Property="Content"><Setter.Value><MultiBinding Converter="{StaticResource StatisticColorLookup}"><Binding Path="Tag" RelativeSource="{RelativeSource Self}"/><Binding Path="DataContext.CounterPlacements" RelativeSource="{RelativeSource AncestorType={x:Type local:LibraryStatisticsSettingsView}}"/></MultiBinding></Setter.Value></Setter></Style>

   <DataTemplate x:Key="StatisticPositionFields"><StackPanel x:Name="StatisticPositionFields" Margin="8,4"><controls:SettingsColumns><controls:SettingsField Label="Row"><numeric:IntBox x:Name="StatisticPositionRow" Value="{Binding Row,UpdateSourceTrigger=PropertyChanged}" MinValue="1" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
    <controls:SettingsField Label="Column"><numeric:IntBox Value="{Binding Column,UpdateSourceTrigger=PropertyChanged}" MinValue="1" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
    <controls:SettingsField Label="Row span"><numeric:IntBox Value="{Binding RowSpan,UpdateSourceTrigger=PropertyChanged}" MinValue="1" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
    <controls:SettingsField Label="Column span"><numeric:IntBox Value="{Binding ColumnSpan,UpdateSourceTrigger=PropertyChanged}" MinValue="1" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField></controls:SettingsColumns>
</StackPanel></DataTemplate>
   <DataTemplate x:Key="StatisticPositionTemplate"><Expander x:Name="StatisticPositionExpander" Header="Position" Foreground="{DynamicResource TextBrush}" Content="{Binding}" ContentTemplate="{StaticResource EmptyStatisticColors}" Expanded="StatisticPosition_Expanded"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.UseCounterGrid,RelativeSource={RelativeSource AncestorType={x:Type local:LibraryStatisticsSettingsView}}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style></Expander></DataTemplate>
   <Style x:Key="StatisticPositionEditor" TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource StatisticPositionTemplate}"/><Setter Property="Content"><Setter.Value><MultiBinding Converter="{StaticResource StatisticColorLookup}" ConverterParameter="Position"><Binding Path="Tag" RelativeSource="{RelativeSource Self}"/><Binding Path="DataContext.CounterPlacements" RelativeSource="{RelativeSource AncestorType={x:Type local:LibraryStatisticsSettingsView}}"/></MultiBinding></Setter.Value></Setter></Style>
   <CollectionViewSource x:Key="AdditionalCounterGroups" Source="{Binding AdditionalCounters}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Section"/></CollectionViewSource.GroupDescriptions></CollectionViewSource>
   <Style x:Key="CustomValueSizeStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding ValueSizePreset}" Value="{x:Static settings:StatisticsTextSize.Custom}"><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers></Style>
   <Style x:Key="CustomLabelSizeStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding LabelSizePreset}" Value="{x:Static settings:StatisticsTextSize.Custom}"><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers></Style>
   <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0"/></DataTemplate></Setter.Value></Setter></Style>
   <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,6,0,3"/></Style></StackPanel.Resources>
  <Expander x:Name="CounterGridOptions" Header="Counter grid" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,4">
   <CheckBox Content="Place counters in a grid" IsChecked="{Binding UseCounterGrid}"/>
   <controls:SettingsColumns><controls:SettingsField Label="Minimum rows"><numeric:IntBox Value="{Binding CounterRows,UpdateSourceTrigger=PropertyChanged}" MinValue="1" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField><controls:SettingsField Label="Minimum columns"><numeric:IntBox Value="{Binding CounterColumns,UpdateSourceTrigger=PropertyChanged}" MinValue="1" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField></controls:SettingsColumns>
   <Button Content="Reset counter positions" Click="ResetCounterPositions_Click"/>
  </StackPanel></Expander>
  <Expander x:Name="CounterOptions" Header="Counters" IsExpanded="True" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,4">
   <Expander Foreground="{DynamicResource TextBrush}"><Expander.Header><CheckBox Content="Total games" IsChecked="{Binding ShowTotal}"/></Expander.Header><StackPanel Margin="8,4"><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{x:Static settings:StatisticsCounter.Total}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{x:Static settings:StatisticsCounter.Total}"/></StackPanel></Expander><Expander Foreground="{DynamicResource TextBrush}"><Expander.Header><CheckBox Content="Installed games" IsChecked="{Binding ShowInstalled}"/></Expander.Header><StackPanel Margin="8,4"><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{x:Static settings:StatisticsCounter.Installed}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{x:Static settings:StatisticsCounter.Installed}"/></StackPanel></Expander>
   <Expander Foreground="{DynamicResource TextBrush}"><Expander.Header><CheckBox Content="Unplayed games" IsChecked="{Binding ShowUnplayed}"/></Expander.Header><StackPanel Margin="8,4"><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{x:Static settings:StatisticsCounter.Unplayed}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{x:Static settings:StatisticsCounter.Unplayed}"/></StackPanel></Expander><Expander Foreground="{DynamicResource TextBrush}"><Expander.Header><CheckBox Content="Completed games" IsChecked="{Binding ShowCompleted}"/></Expander.Header><StackPanel Margin="8,4"><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{x:Static settings:StatisticsCounter.Completed}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{x:Static settings:StatisticsCounter.Completed}"/></StackPanel></Expander><Expander Foreground="{DynamicResource TextBrush}"><Expander.Header><CheckBox Content="Total playtime" IsChecked="{Binding ShowPlaytime}"/></Expander.Header><StackPanel Margin="8,4"><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{x:Static settings:StatisticsCounter.TotalPlaytime}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{x:Static settings:StatisticsCounter.TotalPlaytime}"/></StackPanel></Expander><Expander Foreground="{DynamicResource TextBrush}"><Expander.Header><CheckBox Content="Average playtime (games with recorded time)" IsChecked="{Binding ShowAveragePlaytime}"/></Expander.Header><StackPanel Margin="8,4"><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{x:Static settings:StatisticsCounter.AveragePlaytime}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{x:Static settings:StatisticsCounter.AveragePlaytime}"/></StackPanel></Expander><Expander Foreground="{DynamicResource TextBrush}"><Expander.Header><CheckBox Content="Games with recorded playtime" IsChecked="{Binding ShowPlayedGames}"/></Expander.Header><StackPanel Margin="8,4"><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{x:Static settings:StatisticsCounter.PlayedGames}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{x:Static settings:StatisticsCounter.PlayedGames}"/></StackPanel></Expander>
  </StackPanel></Expander>
  <Expander x:Name="AdditionalCounterOptions" Header="More statistics" Foreground="{DynamicResource TextBrush}"><ItemsControl ItemsSource="{Binding Source={StaticResource AdditionalCounterGroups}}" Margin="8,4">
   <ItemsControl.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander Header="{Binding Name}" Foreground="{DynamicResource TextBrush}"><ItemsPresenter Margin="8,4"/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ItemsControl.GroupStyle>
   <ItemsControl.ItemTemplate><DataTemplate><Expander Foreground="{DynamicResource TextBrush}"><Expander.Header><CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled}"/></Expander.Header><StackPanel Margin="8,4"><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{Binding Counter}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{Binding Counter}"/></StackPanel></Expander></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl></Expander>
  <Expander x:Name="StatisticGroupOptions" Header="Breakdowns by source and metadata" Foreground="{DynamicResource TextBrush}"><ItemsControl ItemsSource="{Binding StatisticGroups}" Margin="8,4"><ItemsControl.ItemTemplate><DataTemplate>
   <Expander Header="{Binding Label}" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,4"><CheckBox Content="Show this breakdown" IsChecked="{Binding Enabled}"/><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{Binding Counter}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{Binding Counter}"/>
   <TextBlock Text="Statistic"/><ComboBox SelectedValue="{Binding Metric}" SelectedValuePath="Tag"><ComboBoxItem Content="Games" Tag="{x:Static settings:StatisticsMetric.GameCount}"/><ComboBoxItem Content="Recorded playtime" Tag="{x:Static settings:StatisticsMetric.Playtime}"/></ComboBox>
   <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SupportsSelection}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
   <CheckBox Content="Show only the selected source / platform" IsChecked="{Binding SelectedOnly}"/>
   <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedId,Mode=TwoWay}" IsEnabled="{Binding SelectedOnly}"/>
   <CheckBox Content="Show source / platform icon" IsChecked="{Binding ShowIcon}"/>
   <TextBlock Text="Icon size"/><numeric:DoubleBox Value="{Binding IconSize,UpdateSourceTrigger=PropertyChanged}" MinValue="8" MaxValue="128" Style="{StaticResource {x:Type TextBox}}"/>
   </StackPanel>
   <CheckBox Content="Show name text" IsChecked="{Binding ShowName}"/><CheckBox Content="Show breakdown heading" IsChecked="{Binding ShowHeading}"/>
   <CheckBox Content="Include games with no assigned value" IsChecked="{Binding IncludeUnassigned}"/><CheckBox Content="Show percentages" IsChecked="{Binding ShowPercentages}"/>
   <TextBlock Text="Maximum entries (0 = all)"/><numeric:IntBox Value="{Binding Limit,UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="2147483647" Style="{StaticResource {x:Type TextBox}}"/>
   </StackPanel></Expander>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
  <Expander x:Name="PeriodOptions" Header="Playtime by period" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,4">
   <Expander Foreground="{DynamicResource TextBrush}"><Expander.Header><CheckBox Content="Playtime today" IsChecked="{Binding ShowTodayPlaytime}"/></Expander.Header><StackPanel Margin="8,4"><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{x:Static settings:StatisticsCounter.Today}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{x:Static settings:StatisticsCounter.Today}"/></StackPanel></Expander><Expander Foreground="{DynamicResource TextBrush}"><Expander.Header><CheckBox Content="Playtime this week" IsChecked="{Binding ShowWeekPlaytime}"/></Expander.Header><StackPanel Margin="8,4"><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{x:Static settings:StatisticsCounter.Week}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{x:Static settings:StatisticsCounter.Week}"/></StackPanel></Expander><Expander Foreground="{DynamicResource TextBrush}"><Expander.Header><CheckBox Content="Playtime this month" IsChecked="{Binding ShowMonthPlaytime}"/></Expander.Header><StackPanel Margin="8,4"><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{x:Static settings:StatisticsCounter.Month}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{x:Static settings:StatisticsCounter.Month}"/></StackPanel></Expander><Expander Foreground="{DynamicResource TextBrush}"><Expander.Header><CheckBox Content="Playtime this year" IsChecked="{Binding ShowYearPlaytime}"/></Expander.Header><StackPanel Margin="8,4"><ContentControl Style="{StaticResource StatisticColorEditor}" Tag="{x:Static settings:StatisticsCounter.Year}"/><ContentControl Style="{StaticResource StatisticPositionEditor}" Tag="{x:Static settings:StatisticsCounter.Year}"/></StackPanel></Expander>
   <TextBlock Text="Week starts on"/><ComboBox SelectedValue="{Binding WeekStartsOn}" SelectedValuePath="Tag"><ComboBoxItem Content="Monday" Tag="{x:Static sys:DayOfWeek.Monday}"/><ComboBoxItem Content="Sunday" Tag="{x:Static sys:DayOfWeek.Sunday}"/><ComboBoxItem Content="Tuesday" Tag="{x:Static sys:DayOfWeek.Tuesday}"/><ComboBoxItem Content="Wednesday" Tag="{x:Static sys:DayOfWeek.Wednesday}"/><ComboBoxItem Content="Thursday" Tag="{x:Static sys:DayOfWeek.Thursday}"/><ComboBoxItem Content="Friday" Tag="{x:Static sys:DayOfWeek.Friday}"/><ComboBoxItem Content="Saturday" Tag="{x:Static sys:DayOfWeek.Saturday}"/></ComboBox>
   <TextBlock Text="Uses recorded GameActivity sessions for the current calendar day/week/month/year in local time. Sessions crossing a boundary are split. Hidden/installed filters also apply. Missing history is not estimated from lifetime playtime." TextWrapping="Wrap"/>
  </StackPanel></Expander>
  <Expander x:Name="ScopeOptions" Header="Library scope" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,4">
   <CheckBox Content="Include hidden games" IsChecked="{Binding IncludeHidden}"/><CheckBox Content="Installed games only" IsChecked="{Binding InstalledOnly}"/>
  </StackPanel></Expander>
  <StackPanel x:Name="MultiChartOptions" Margin="0,4">
   <Button Content="Edit charts on widget" Click="EditCharts_Click" Margin="0,0,0,8"/>
   <TextBlock Text="Chart columns"/><numeric:IntBox Value="{Binding ChartColumns,UpdateSourceTrigger=PropertyChanged}" MinValue="1" MaxValue="2147483647" Style="{StaticResource {x:Type TextBox}}"/>
   <ListBox x:Name="ExtraChartList" DisplayMemberPath="ChartName" MinHeight="70" MaxHeight="180" SelectionChanged="ExtraChart_SelectionChanged"/>
   <WrapPanel Margin="0,6,0,2"><Button Margin="0,0,8,8" Padding="10,5" MinHeight="30" Content="Add chart" Click="AddChart_Click"/><Button Margin="0,0,8,8" Padding="10,5" MinHeight="30" Content="Duplicate" Click="DuplicateChart_Click"/><Button Margin="0,0,8,8" Padding="10,5" MinHeight="30" x:Name="RemoveChartButton" Content="Remove" Click="RemoveChart_Click"/><Button Margin="0,0,8,8" Padding="10,5" MinHeight="30" x:Name="MoveChartUpButton" Content="Move up" Click="MoveChartUp_Click"/><Button Margin="0,0,8,8" Padding="10,5" MinHeight="30" x:Name="MoveChartDownButton" Content="Move down" Click="MoveChartDown_Click"/></WrapPanel>
   <ContentControl x:Name="ExtraChartEditor"/>
  </StackPanel>
  <Expander x:Name="ChartOptions" Header="Chart" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,4">
   <CheckBox x:Name="ShowChartOption" Content="Show chart" IsChecked="{Binding ShowChart}"/>
   <CheckBox Content="Animate chart updates" IsChecked="{Binding ChartAnimations}"/>
   <CheckBox Content="Show bar chart axis labels" IsChecked="{Binding ShowChartAxes}"/>
   <CheckBox Content="Show bar chart grid lines" IsChecked="{Binding ShowChartGrid}"/>
   <controls:SettingsSlider Label="Segment border width (0 = none)" Value="{Binding SliceSeparatorWidth}" Minimum="0" Maximum="10" Step="0.5" Precision="1"/>
   <controls:SettingsColumns><controls:SettingsField Label="Chart style"><ComboBox SelectedValue="{Binding ChartStyle}" SelectedValuePath="Tag"><ComboBoxItem Content="Horizontal bars" Tag="{x:Static settings:StatisticsChartStyle.Bars}"/><ComboBoxItem Content="Vertical bars" Tag="{x:Static settings:StatisticsChartStyle.VerticalBars}"/><ComboBoxItem Content="Doughnut" Tag="{x:Static settings:StatisticsChartStyle.Doughnut}"/><ComboBoxItem Content="Pie" Tag="{x:Static settings:StatisticsChartStyle.Pie}"/></ComboBox></controls:SettingsField><controls:SettingsField Label="Statistic"><ComboBox SelectedValue="{Binding Metric}" SelectedValuePath="Tag"><ComboBoxItem Content="Number of games" Tag="{x:Static settings:StatisticsMetric.GameCount}"/><ComboBoxItem Content="Recorded playtime (hours)" Tag="{x:Static settings:StatisticsMetric.Playtime}"/></ComboBox></controls:SettingsField></controls:SettingsColumns>
   <TextBlock Text="Breakdown"/><ComboBox SelectedValue="{Binding Breakdown}" SelectedValuePath="Tag">
    <ComboBoxItem Content="Installation" Tag="{x:Static settings:StatisticsBreakdown.Installation}"/><ComboBoxItem Content="Played / unplayed" Tag="{x:Static settings:StatisticsBreakdown.Played}"/><ComboBoxItem Content="Completed / other games" Tag="{x:Static settings:StatisticsBreakdown.Completed}"/><ComboBoxItem Content="Sources" Tag="{x:Static settings:StatisticsBreakdown.Sources}"/><ComboBoxItem Content="Platforms" Tag="{x:Static settings:StatisticsBreakdown.Platforms}"/><ComboBoxItem Content="Genres" Tag="{x:Static settings:StatisticsBreakdown.Genres}"/><ComboBoxItem Content="Completion statuses" Tag="{x:Static settings:StatisticsBreakdown.CompletionStatuses}"/>
    <ComboBoxItem Content="Individual games (use playtime for most-played games)" Tag="{x:Static settings:StatisticsBreakdown.Games}"/><ComboBoxItem Content="Playtime ranges" Tag="{x:Static settings:StatisticsBreakdown.PlaytimeRanges}"/>
   </ComboBox>
   <controls:SettingsColumns><controls:SettingsField Label="Chart name"><TextBox Text="{Binding ChartName,UpdateSourceTrigger=PropertyChanged}"/></controls:SettingsField><controls:SettingsField Label="Custom chart title (blank = automatic)"><TextBox Text="{Binding ChartTitle,UpdateSourceTrigger=PropertyChanged}"/></controls:SettingsField></controls:SettingsColumns>
   <CheckBox Content="Show labels / legend" IsChecked="{Binding ShowLegend}"/><CheckBox Content="Show percentages" IsChecked="{Binding ShowPercentages}"/>
   <Expander Header="Label placement" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,4">
    <controls:SettingsColumns><controls:SettingsField Label="Label position"><ComboBox SelectedValue="{Binding LabelPosition}" SelectedValuePath="Tag"><ComboBoxItem Content="Grouped legend" Tag="{x:Static settings:StatisticsLabelPosition.Legend}"/><ComboBoxItem Content="Beside each bar / pie or doughnut segment" Tag="{x:Static settings:StatisticsLabelPosition.BesideSegments}"/><ComboBoxItem Content="Above bars / inside slices (outside if too large)" Tag="{x:Static settings:StatisticsLabelPosition.AboveBars}"/></ComboBox></controls:SettingsField><controls:SettingsField Label="Grouped legend position"><ComboBox SelectedValue="{Binding LegendPosition}" SelectedValuePath="Tag"><ComboBoxItem Content="Bottom" Tag="{x:Static settings:StatisticsLegendPosition.Bottom}"/><ComboBoxItem Content="Top" Tag="{x:Static settings:StatisticsLegendPosition.Top}"/><ComboBoxItem Content="Left" Tag="{x:Static settings:StatisticsLegendPosition.Left}"/><ComboBoxItem Content="Right" Tag="{x:Static settings:StatisticsLegendPosition.Right}"/></ComboBox></controls:SettingsField><controls:SettingsField Label="Legend horizontal alignment"><ComboBox SelectedValue="{Binding LegendAlignment}" SelectedValuePath="Tag"><ComboBoxItem Content="Left" Tag="{x:Static HorizontalAlignment.Left}"/><ComboBoxItem Content="Center" Tag="{x:Static HorizontalAlignment.Center}"/><ComboBoxItem Content="Right" Tag="{x:Static HorizontalAlignment.Right}"/></ComboBox></controls:SettingsField><controls:SettingsField Label="Side legend vertical alignment"><ComboBox SelectedValue="{Binding LegendVerticalAlignment}" SelectedValuePath="Tag"><ComboBoxItem Content="Top" Tag="{x:Static VerticalAlignment.Top}"/><ComboBoxItem Content="Center" Tag="{x:Static VerticalAlignment.Center}"/><ComboBoxItem Content="Bottom" Tag="{x:Static VerticalAlignment.Bottom}"/></ComboBox></controls:SettingsField></controls:SettingsColumns>
    <CheckBox Content="Arrange grouped labels horizontally (top/bottom legends)" IsChecked="{Binding LegendHorizontal}"/>
    <controls:SettingsColumns><controls:SettingsField Label="Outside label distance"><numeric:DoubleBox Value="{Binding OutsideLabelDistance,UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="500" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField><controls:SettingsField Label="Move labels horizontally"><numeric:DoubleBox Value="{Binding LabelOffsetX,UpdateSourceTrigger=PropertyChanged}" MinValue="-2000" MaxValue="2000" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField><controls:SettingsField Label="Move labels vertically"><numeric:DoubleBox Value="{Binding LabelOffsetY,UpdateSourceTrigger=PropertyChanged}" MinValue="-2000" MaxValue="2000" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField></controls:SettingsColumns>
    <CheckBox Content="Show connector lines" IsChecked="{Binding ShowConnectorLines}"/>
    <controls:SettingsColumns><controls:SettingsField Label="Connector style"><ComboBox SelectedValue="{Binding ConnectorStyle}" SelectedValuePath="Tag"><ComboBoxItem Content="Elbow" Tag="{x:Static settings:ChartConnectorStyle.Elbow}"/><ComboBoxItem Content="Straight" Tag="{x:Static settings:ChartConnectorStyle.Straight}"/></ComboBox></controls:SettingsField><controls:SettingsField Label="Connector thickness"><numeric:DoubleBox Value="{Binding ConnectorThickness,UpdateSourceTrigger=PropertyChanged}" MinValue="0.1" MaxValue="20" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField></controls:SettingsColumns>
    <Expander Header="Individual label offsets" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,4"><ItemsControl ItemsSource="{Binding LabelOffsets}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Name}" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,4"><TextBlock Text="Horizontal offset"/><numeric:DoubleBox Value="{Binding X,UpdateSourceTrigger=PropertyChanged}" MinValue="-2000" MaxValue="2000" Style="{StaticResource {x:Type TextBox}}"/><TextBlock Text="Vertical offset"/><numeric:DoubleBox Value="{Binding Y,UpdateSourceTrigger=PropertyChanged}" MinValue="-2000" MaxValue="2000" Style="{StaticResource {x:Type TextBox}}"/></StackPanel></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Reset label offsets" Click="ResetLabelOffsets_Click"/></StackPanel></Expander>
    <TextBlock Text="Label width"/><numeric:DoubleBox Value="{Binding LabelWidth,UpdateSourceTrigger=PropertyChanged}" MinValue="50" MaxValue="600" Style="{StaticResource {x:Type TextBox}}"/>
   </StackPanel></Expander>
   <controls:SettingsColumns><controls:SettingsField Label="Chart width (0 = fit available width)"><numeric:DoubleBox Value="{Binding ChartWidth,UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="4000" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField><controls:SettingsField Label="Chart height"><numeric:DoubleBox Value="{Binding ChartHeight,UpdateSourceTrigger=PropertyChanged}" MinValue="60" MaxValue="1000" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField><controls:SettingsField Label="Chart scale"><numeric:DoubleBox Value="{Binding ChartScale,UpdateSourceTrigger=PropertyChanged}" MinValue="0.1" MaxValue="4" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField></controls:SettingsColumns>
   <controls:SettingsField Label="Pie / doughnut rotation"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="RotationSlider" Value="{Binding ChartRotation,UpdateSourceTrigger=PropertyChanged}" Minimum="-360" Maximum="360" SmallChange="1" LargeChange="15" TickFrequency="15" VerticalAlignment="Center"/><numeric:DoubleBox Grid.Column="1" Width="64" Margin="8,0,0,0" Value="{Binding ChartRotation,UpdateSourceTrigger=PropertyChanged}" MinValue="-360" MaxValue="360" Style="{StaticResource {x:Type TextBox}}"/></Grid></controls:SettingsField>
   <controls:SettingsSlider Label="Doughnut hole size" Value="{Binding HoleSize}" Minimum="0.1" Maximum="0.9" Step="0.05" Precision="2"/>
   <TextBlock Text="Maximum groups (0 = all; remaining groups combine as Other)" TextWrapping="Wrap"/><numeric:IntBox Value="{Binding GroupLimit,UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="2147483647" Style="{StaticResource {x:Type TextBox}}"/>
  </StackPanel></Expander>
  <Expander x:Name="ChartColors" Header="Colors" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,4">

   <UniformGrid Columns="3"><controls:PopupColorPicker x:Name="GlobalTextColorToggle" Label="Text" Margin="0,4,8,4" UseCustomColor="{Binding CustomLabelColor,Mode=TwoWay}" SelectedColor="{Binding LabelColor,Mode=TwoWay}" CustomColorChanged="GlobalTextColor_Editing"/></UniformGrid>
   <StackPanel x:Name="ChartPaletteOptions">

   <CheckBox Content="Glossy series colors" IsChecked="{Binding GlossySeries}"/>

   <CheckBox Content="Use custom chart colors" IsChecked="{Binding CustomChartColors}"/>
   <TextBlock Text="Series colors cycle in descending value order. Turn this off to use the default colorful palette." TextWrapping="Wrap"/>


   <UniformGrid Columns="3"><controls:PopupColorPicker Label="segment border color" UseCustomColor="{Binding CustomSegmentBorderColor}" Margin="0,4,8,4" SelectedColor="{Binding SegmentBorderColor,Mode=TwoWay}"/><controls:PopupColorPicker Label="connector color" UseCustomColor="{Binding CustomConnectorColor}" Margin="0,4,8,4" SelectedColor="{Binding ConnectorColor,Mode=TwoWay}"/><controls:PopupColorPicker Label="Series 1" ShowCustomColorOption="False" Margin="0,4,8,4" SelectedColor="{Binding ChartColor1,Mode=TwoWay}"/><controls:PopupColorPicker Label="Series 2" ShowCustomColorOption="False" Margin="0,4,8,4" SelectedColor="{Binding ChartColor2,Mode=TwoWay}"/><controls:PopupColorPicker Label="Series 3" ShowCustomColorOption="False" Margin="0,4,8,4" SelectedColor="{Binding ChartColor3,Mode=TwoWay}"/><controls:PopupColorPicker Label="Series 4" ShowCustomColorOption="False" Margin="0,4,8,4" SelectedColor="{Binding ChartColor4,Mode=TwoWay}"/><controls:PopupColorPicker Label="Series 5" ShowCustomColorOption="False" Margin="0,4,8,4" SelectedColor="{Binding ChartColor5,Mode=TwoWay}"/><controls:PopupColorPicker Label="Series 6" ShowCustomColorOption="False" Margin="0,4,8,4" SelectedColor="{Binding ChartColor6,Mode=TwoWay}"/></UniformGrid>
     </StackPanel>
  </StackPanel></Expander>
  <Expander x:Name="LayoutTextOptions" Header="Layout and text" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,4">
   <CheckBox x:Name="RowsOption" Content="Show as rows instead of wrapping tiles" IsChecked="{Binding Rows}"/>
<controls:TextSettingsSelector x:Name="TextEditor">
<controls:TextSettingsEntry Header="Statistic values">   <StackPanel x:Name="ValueTextOptions" Margin="8,4">
   <TextBlock Text="Value font"/><ComboBox ItemsSource="{x:Static Fonts.SystemFontFamilies}" SelectedValue="{Binding ValueFontFamily}" SelectedValuePath="Source"/><Button Content="Use theme value font" Click="ThemeValueFont_Click"/>
   <WrapPanel><ToggleButton IsChecked="{Binding ValueBold}" ToolTip="Bold values" AutomationProperties.Name="Bold values" Width="32" Height="28" Margin="0,4,5,4" Foreground="{DynamicResource TextBrush}"><TextBlock Text="B" FontWeight="Bold" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></ToggleButton><ToggleButton IsChecked="{Binding ValueItalic}" ToolTip="Italic values" AutomationProperties.Name="Italic values" Width="32" Height="28" Margin="0,4,5,4" Foreground="{DynamicResource TextBrush}"><TextBlock Text="I" FontStyle="Italic" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></ToggleButton><ToggleButton IsChecked="{Binding ValueUnderline}" ToolTip="Underline values" AutomationProperties.Name="Underline values" Width="32" Height="28" Margin="0,4,5,4" Foreground="{DynamicResource TextBrush}"><TextBlock Text="U" TextDecorations="Underline" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></ToggleButton><ToggleButton IsChecked="{Binding ValueStrikeThrough}" ToolTip="Strike through values" AutomationProperties.Name="Strike through values" Width="32" Height="28" Margin="0,4,5,4" Foreground="{DynamicResource TextBrush}"><TextBlock Text="S" TextDecorations="Strikethrough" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></ToggleButton>
   </WrapPanel><TextBlock Text="Value size preset"/><ComboBox SelectedValue="{Binding ValueSizePreset}" SelectedValuePath="Tag"><ComboBoxItem Content="Custom size" Tag="{x:Static settings:StatisticsTextSize.Custom}"/><ComboBoxItem Content="Theme small" Tag="{x:Static settings:StatisticsTextSize.ThemeSmall}"/><ComboBoxItem Content="Theme normal" Tag="{x:Static settings:StatisticsTextSize.ThemeNormal}"/><ComboBoxItem Content="Theme large" Tag="{x:Static settings:StatisticsTextSize.ThemeLarge}"/><ComboBoxItem Content="Theme larger" Tag="{x:Static settings:StatisticsTextSize.ThemeLarger}"/><ComboBoxItem Content="Theme largest" Tag="{x:Static settings:StatisticsTextSize.ThemeLargest}"/></ComboBox>
   <TextBlock x:Name="ValueSizeLabel" Text="Value size"/><numeric:DoubleBox x:Name="ValueSizeInput" Value="{Binding ValueSize, UpdateSourceTrigger=PropertyChanged}" MinValue="8" MaxValue="200" Style="{StaticResource CustomValueSizeStyle}"/>
   <controls:SettingsSlider Label="Value opacity" Value="{Binding ValueOpacity}" Minimum="0" Maximum="1" Step="0.05" Precision="2"/>
   </StackPanel></controls:TextSettingsEntry>
<controls:TextSettingsEntry Header="Labels">   <StackPanel Margin="8,4">
   <TextBlock Text="Label font"/><ComboBox ItemsSource="{x:Static Fonts.SystemFontFamilies}" SelectedValue="{Binding LabelFontFamily}" SelectedValuePath="Source"/><Button Content="Use theme label font" Click="ThemeFont_Click"/>
   <WrapPanel><ToggleButton IsChecked="{Binding LabelBold}" ToolTip="Bold labels" AutomationProperties.Name="Bold labels" Width="32" Height="28" Margin="0,4,5,4" Foreground="{DynamicResource TextBrush}"><TextBlock Text="B" FontWeight="Bold" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></ToggleButton><ToggleButton IsChecked="{Binding LabelItalic}" ToolTip="Italic labels" AutomationProperties.Name="Italic labels" Width="32" Height="28" Margin="0,4,5,4" Foreground="{DynamicResource TextBrush}"><TextBlock Text="I" FontStyle="Italic" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></ToggleButton><ToggleButton IsChecked="{Binding LabelUnderline}" ToolTip="Underline labels" AutomationProperties.Name="Underline labels" Width="32" Height="28" Margin="0,4,5,4" Foreground="{DynamicResource TextBrush}"><TextBlock Text="U" TextDecorations="Underline" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></ToggleButton>
   <ToggleButton x:Name="CounterLabelStrikeToggle" IsChecked="{Binding LabelStrikeThrough}" ToolTip="Strike through labels" AutomationProperties.Name="Strike through labels" Width="32" Height="28" Margin="0,4,5,4" Foreground="{DynamicResource TextBrush}"><TextBlock Text="S" TextDecorations="Strikethrough" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></ToggleButton></WrapPanel><TextBlock Text="Label size"/><numeric:DoubleBox Value="{Binding LabelSize, UpdateSourceTrigger=PropertyChanged}" MinValue="8" MaxValue="100" Style="{StaticResource CustomLabelSizeStyle}"/>
   <StackPanel x:Name="CounterLabelTextOptions">
   <TextBlock Text="Label size preset"/><ComboBox SelectedValue="{Binding LabelSizePreset}" SelectedValuePath="Tag"><ComboBoxItem Content="Custom size" Tag="{x:Static settings:StatisticsTextSize.Custom}"/><ComboBoxItem Content="Theme small" Tag="{x:Static settings:StatisticsTextSize.ThemeSmall}"/><ComboBoxItem Content="Theme normal" Tag="{x:Static settings:StatisticsTextSize.ThemeNormal}"/><ComboBoxItem Content="Theme large" Tag="{x:Static settings:StatisticsTextSize.ThemeLarge}"/><ComboBoxItem Content="Theme larger" Tag="{x:Static settings:StatisticsTextSize.ThemeLarger}"/><ComboBoxItem Content="Theme largest" Tag="{x:Static settings:StatisticsTextSize.ThemeLargest}"/></ComboBox>
   <controls:SettingsSlider Label="Label opacity" Value="{Binding LabelOpacity}" Minimum="0" Maximum="1" Step="0.05" Precision="2"/>
   <TextBlock Text="Label line height (0 = automatic)"/><numeric:DoubleBox Value="{Binding LabelLineHeight,UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="300" Style="{StaticResource {x:Type TextBox}}"/>
   </StackPanel>
   </StackPanel></controls:TextSettingsEntry>
</controls:TextSettingsSelector>


   <Expander x:Name="CounterRenderingOptions" Header="Wrapping and text rendering" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,4">
   <CheckBox Content="Wrap counter text" IsChecked="{Binding WrapCounterText}"/>
   <controls:SettingsField Label="Text trimming"><ComboBox SelectedValue="{Binding CounterTextTrimming}" SelectedValuePath="Tag"><ComboBoxItem Content="None" Tag="{x:Static TextTrimming.None}"/><ComboBoxItem Content="Character ellipsis" Tag="{x:Static TextTrimming.CharacterEllipsis}"/><ComboBoxItem Content="Word ellipsis" Tag="{x:Static TextTrimming.WordEllipsis}"/></ComboBox></controls:SettingsField>
   <CheckBox Content="Use Playnite text rendering settings" IsChecked="{Binding InheritTextRendering}"/>
   <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding InheritTextRendering}" Value="False"><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
   <controls:SettingsColumns><controls:SettingsField Label="Formatting (when overriding)"><ComboBox SelectedValue="{Binding TextFormatting}" SelectedValuePath="Tag"><ComboBoxItem Content="Ideal" Tag="{x:Static TextFormattingMode.Ideal}"/><ComboBoxItem Content="Display" Tag="{x:Static TextFormattingMode.Display}"/></ComboBox></controls:SettingsField><controls:SettingsField Label="Rendering (when overriding)"><ComboBox SelectedValue="{Binding TextRendering}" SelectedValuePath="Tag"><ComboBoxItem Content="Auto" Tag="{x:Static TextRenderingMode.Auto}"/><ComboBoxItem Content="ClearType" Tag="{x:Static TextRenderingMode.ClearType}"/><ComboBoxItem Content="Grayscale" Tag="{x:Static TextRenderingMode.Grayscale}"/><ComboBoxItem Content="Aliased" Tag="{x:Static TextRenderingMode.Aliased}"/></ComboBox></controls:SettingsField></controls:SettingsColumns>
   </StackPanel>
   </StackPanel></Expander>
   <TextBlock x:Name="TileWidthLabel" Text="Tile / row label width"/><numeric:DoubleBox x:Name="TileWidthInput" Value="{Binding TileWidth, UpdateSourceTrigger=PropertyChanged}" MinValue="60" MaxValue="1000" Style="{StaticResource {x:Type TextBox}}"/>
   <controls:SettingsColumns><controls:SettingsField Label="Spacing"><numeric:DoubleBox Value="{Binding Spacing, UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField><controls:SettingsField Label="Text alignment"><ComboBox SelectedValue="{Binding Alignment}" SelectedValuePath="Tag"><ComboBoxItem Content="Left" Tag="{x:Static TextAlignment.Left}"/><ComboBoxItem Content="Center" Tag="{x:Static TextAlignment.Center}"/><ComboBoxItem Content="Right" Tag="{x:Static TextAlignment.Right}"/></ComboBox></controls:SettingsField></controls:SettingsColumns>
   <TextBlock Text="Use Appearance settings for panel backgrounds, borders and the Colors section for text colors." TextWrapping="Wrap"/>
  </StackPanel></Expander>
 </StackPanel>
</UserControl>
