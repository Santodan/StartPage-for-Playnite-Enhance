<UserControl x:Class="LandingPage.Views.Settings.ToolbarSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:LandingPage.Views.Settings"
 xmlns:controls="clr-namespace:LandingPage.Controls"
 xmlns:settings="clr-namespace:LandingPage.Settings"
 xmlns:numeric="http://gu.se/NumericInput">
 <UserControl.Resources>
  <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
  <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Padding" Value="8,2"/></Style>
  <DataTemplate x:Key="ToolbarOptionTemplate">
   <StackPanel Orientation="Horizontal">
    <controls:ToolbarIcon Option="{Binding}" Margin="0,0,8,0"/>
    <TextBlock Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}" Text="{Binding Title}" VerticalAlignment="Center"/>
   </StackPanel>
  </DataTemplate>
 </UserControl.Resources>
 <StackPanel>
  <controls:SettingsHint Margin="0,0,0,4" Text="Add page navigation or native Playnite toolbar items, then choose their order. Native commands keep Playnite's own availability rules. The picker includes native toolbar buttons, extension actions, and Sidebar entries such as Aniki Helper. Turn off Show labels for an icon-only toolbar."/>
  <controls:SettingsField Label="Notification badge">
   <ComboBox SelectedValue="{Binding NotificationBadgeStyle}" SelectedValuePath="Tag">
    <ComboBoxItem Content="Dot" Tag="{x:Static settings:NotificationBadgeStyle.Dot}"/>
    <ComboBoxItem Content="Count" Tag="{x:Static settings:NotificationBadgeStyle.Count}"/>
   </ComboBox>
   <controls:SettingsHint Text="The badge is hidden when there are no notifications."/>
  </controls:SettingsField>
  <Expander Header="Toolbar items" IsExpanded="True" Margin="0,8,0,0">
   <StackPanel Margin="8,6,0,8">
    <controls:SettingsField Label="Group">
     <ComboBox x:Name="ItemGroupSelector" ItemsSource="{Binding Groups}" DisplayMemberPath="Name" IsSynchronizedWithCurrentItem="False"
               SelectedItem="{Binding SelectedGroup, RelativeSource={RelativeSource AncestorType=local:ToolbarSettingsView}, Mode=TwoWay}"/>
     <controls:SettingsHint Text="Showing items from this group. New items are added here; the arrows reorder items within this group."/>
    </controls:SettingsField>
    <controls:SettingsField Label="Add an item">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="OptionPicker" ItemsSource="{Binding AvailableOptions, RelativeSource={RelativeSource AncestorType=local:ToolbarSettingsView}}" ItemTemplate="{StaticResource ToolbarOptionTemplate}" SelectedValuePath="Id" MaxDropDownHeight="320"/>
      <Button Grid.Column="1" Content="Add item" Click="AddItem_Click" Margin="6,0,0,0" Padding="10,4"/>
     </Grid>
    </controls:SettingsField>
    <Button Content="Refresh native items" Click="RefreshItems_Click" HorizontalAlignment="Left" Padding="10,4" Margin="0,6,0,6"/>
    <ItemsControl x:Name="GroupItemsList" ItemsSource="{Binding ItemsView, RelativeSource={RelativeSource AncestorType=local:ToolbarSettingsView}}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border BorderBrush="{DynamicResource NormalBrush}" BorderThickness="0,0,0,1" Padding="0,6">
        <StackPanel>
         <ComboBox ItemsSource="{Binding AvailableOptions, RelativeSource={RelativeSource AncestorType=local:ToolbarSettingsView}}" SelectedValue="{Binding Id, Mode=OneWay}" SelectionChanged="EntrySelectionChanged" SelectedValuePath="Id" ItemTemplate="{StaticResource ToolbarOptionTemplate}" MaxDropDownHeight="320"/>
         <controls:SettingsColumns>
          <controls:SettingsField Label="Group">
           <ComboBox ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=local:ToolbarSettingsView}}" SelectedValue="{Binding GroupId, Mode=OneWay}" SelectionChanged="EntryGroupSelectionChanged" SelectedValuePath="Id" DisplayMemberPath="Name"/>
          </controls:SettingsField>
          <controls:SettingsField Label="Open extension">
           <controls:SettingsField.Style>
            <Style TargetType="controls:SettingsField"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanChooseOpenMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
           </controls:SettingsField.Style>
           <ComboBox SelectedValue="{Binding OpenMode}" SelectedValuePath="Tag">
            <ComboBoxItem Content="Automatic (overlay when supported)" Tag="{x:Static settings:ExtensionOpenMode.Automatic}"/>
            <ComboBoxItem Content="Extension page (when available)" Tag="{x:Static settings:ExtensionOpenMode.ExtensionPage}"/>
           </ComboBox>
          </controls:SettingsField>
         </controls:SettingsColumns>
         <controls:SettingsField Label="Custom label (blank = default)">
          <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
         </controls:SettingsField>
         <WrapPanel Margin="0,6,0,0">
          <Button Content="&#x2191;" ToolTip="Move earlier" Click="MoveEarlier_Click" Style="{StaticResource RowButton}"/>
          <Button Content="&#x2193;" ToolTip="Move later" Click="MoveLater_Click" Style="{StaticResource RowButton}"/>
          <Button Content="Remove" Click="RemoveItem_Click" Style="{StaticResource RowButton}"/>
         </WrapPanel>
        </StackPanel>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </Expander>
  <Expander Header="Groups and alignment" Margin="0,6,0,0">
   <StackPanel Margin="8,6,0,8">
    <controls:SettingsHint Margin="0,0,0,6" Text="Assign items to groups above. Choose Fill, Fit contents, or Fixed size, then customize each group independently."/>
    <Button Content="Add group" Click="AddGroup_Click" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,6"/>
    <ItemsControl ItemsSource="{Binding Groups}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border BorderBrush="{DynamicResource NormalBrush}" BorderThickness="0,0,0,1" Padding="0,4,0,8">
        <StackPanel>
         <controls:SettingsField Label="Group name"><TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/></controls:SettingsField>
         <controls:SettingsColumns>
          <controls:SettingsField Label="Horizontal alignment">
           <ComboBox SelectedValue="{Binding Alignment}" SelectedValuePath="Tag">
            <ComboBoxItem Content="Left" Tag="{x:Static HorizontalAlignment.Left}"/>
            <ComboBoxItem Content="Center" Tag="{x:Static HorizontalAlignment.Center}"/>
            <ComboBoxItem Content="Right" Tag="{x:Static HorizontalAlignment.Right}"/>
           </ComboBox>
          </controls:SettingsField>
          <controls:SettingsField Label="Vertical alignment">
           <ComboBox SelectedValue="{Binding VerticalAlignment}" SelectedValuePath="Tag">
            <ComboBoxItem Content="Top" Tag="{x:Static VerticalAlignment.Top}"/>
            <ComboBoxItem Content="Center" Tag="{x:Static VerticalAlignment.Center}"/>
            <ComboBoxItem Content="Bottom" Tag="{x:Static VerticalAlignment.Bottom}"/>
           </ComboBox>
          </controls:SettingsField>
         </controls:SettingsColumns>
         <Expander Header="Group size" Margin="0,6,0,0">
          <StackPanel Margin="8,6,0,8">
           <controls:SettingsColumns>
            <controls:SettingsField Label="Width sizing">
             <ComboBox SelectedValue="{Binding WidthSizing}" SelectedValuePath="Tag">
              <ComboBoxItem Content="Fill available space" Tag="{x:Static settings:ToolbarGroupSizing.Fill}"/>
              <ComboBoxItem Content="Fit contents" Tag="{x:Static settings:ToolbarGroupSizing.Content}"/>
              <ComboBoxItem Content="Fixed size" Tag="{x:Static settings:ToolbarGroupSizing.Fixed}"/>
             </ComboBox>
            </controls:SettingsField>
            <controls:SettingsField Label="Fixed width (pixels)"><numeric:DoubleBox Value="{Binding Width}" MinValue="24" MaxValue="4000" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
            <controls:SettingsField Label="Height sizing">
             <ComboBox SelectedValue="{Binding HeightSizing}" SelectedValuePath="Tag">
              <ComboBoxItem Content="Fill available space" Tag="{x:Static settings:ToolbarGroupSizing.Fill}"/>
              <ComboBoxItem Content="Fit contents" Tag="{x:Static settings:ToolbarGroupSizing.Content}"/>
              <ComboBoxItem Content="Fixed size" Tag="{x:Static settings:ToolbarGroupSizing.Fixed}"/>
             </ComboBox>
            </controls:SettingsField>
            <controls:SettingsField Label="Fixed height (pixels)"><numeric:DoubleBox Value="{Binding Height}" MinValue="24" MaxValue="4000" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
            <controls:SettingsField Label="Share of remaining space (Fill groups)"><numeric:DoubleBox Value="{Binding Weight}" MinValue="0.1" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
           </controls:SettingsColumns>
          </StackPanel>
         </Expander>
         <Expander Header="Group appearance" Margin="0,6,0,0">
          <StackPanel Margin="8,6,0,8">
           <CheckBox Content="Show background" IsChecked="{Binding ShowBackground}" Margin="0"/>
           <controls:SettingsSlider Label="Background opacity" Value="{Binding BackgroundOpacity}" Minimum="0" Maximum="1" Step="0.01" Precision="2"/>
           <controls:SettingsColumns>
            <controls:SettingsField Label="Border width"><numeric:DoubleBox Value="{Binding BorderWidth}" MinValue="0" MaxValue="20" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
            <controls:SettingsField Label="Corner radius"><numeric:DoubleBox Value="{Binding CornerRadius}" MinValue="0" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
            <controls:SettingsField Label="Internal padding"><numeric:DoubleBox Value="{Binding Padding}" MinValue="0" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
            <controls:SettingsField Label="Outer spacing"><numeric:DoubleBox Value="{Binding Margin}" MinValue="0" MaxValue="100" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
           </controls:SettingsColumns>
           <Expander Header="Colors" Margin="0,6,0,0"><UniformGrid Columns="3" Margin="8,6,0,8">
            <controls:PopupColorPicker Label="Background color" ShowCustomColorOption="False" Margin="0,4,8,4" SelectedColor="{Binding Background, Mode=TwoWay, ValidatesOnExceptions=True}"/>
            <controls:PopupColorPicker Label="Border color" ShowCustomColorOption="False" Margin="0,4,8,4" SelectedColor="{Binding BorderColor, Mode=TwoWay, ValidatesOnExceptions=True}"/>
           </UniformGrid></Expander>
           <Button Content="Reset group appearance" Click="ResetGroupAppearance_Click" HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0"/>
          </StackPanel>
         </Expander>
         <WrapPanel Margin="0,6,0,0">
          <Button Content="Move earlier" Click="MoveGroupEarlier_Click" Style="{StaticResource RowButton}"/>
          <Button Content="Move later" Click="MoveGroupLater_Click" Style="{StaticResource RowButton}"/>
          <Button Content="Remove group" Click="RemoveGroup_Click" Style="{StaticResource RowButton}"/>
         </WrapPanel>
        </StackPanel>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </Expander>
  <Expander Header="Toolbar layout" Margin="0,6,0,0">
   <StackPanel Margin="8,6,0,8">
    <controls:SettingsField Label="Direction">
     <ComboBox SelectedValue="{Binding Orientation}" SelectedValuePath="Tag">
      <ComboBoxItem Content="Horizontal" Tag="{x:Static Orientation.Horizontal}"/>
      <ComboBoxItem Content="Vertical" Tag="{x:Static Orientation.Vertical}"/>
     </ComboBox>
    </controls:SettingsField>
    <controls:SettingsColumns>
     <CheckBox Content="Show icons" IsChecked="{Binding ShowIcons}"/>
     <CheckBox Content="Show labels" IsChecked="{Binding ShowLabels}"/>
    </controls:SettingsColumns>
    <controls:SettingsColumns>
     <controls:SettingsField Label="Text size"><numeric:DoubleBox Value="{Binding FontSize}" MinValue="8" MaxValue="48" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
     <controls:SettingsField Label="Item spacing"><numeric:DoubleBox Value="{Binding Spacing}" MinValue="0" MaxValue="40" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
    </controls:SettingsColumns>
   </StackPanel>
  </Expander>
  <controls:SettingsHint Margin="0,8,0,0" Text="Native dropdowns reuse Playnite's existing menus. A theme that omits a native control may make its item unavailable. Extension buttons appear when supplied by the native toolbar. Manage pages is also available from StartPage's right-click menu."/>
 </StackPanel>
</UserControl>
