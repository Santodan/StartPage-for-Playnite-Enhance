<UserControl x:Class="LandingPage.Views.Settings.MostPlayedSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lp="clr-namespace:LandingPage"
             xmlns:controls="clr-namespace:LandingPage.Controls"
             xmlns:ext="clr-namespace:PlayniteCommon.Extensions;assembly=felixkmh.PlayniteCommon"
             xmlns:m="clr-namespace:LandingPage.Models.GameActivity"
             xmlns:numeric="http://gu.se/NumericInput"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=False, Type={x:Type lp:LandingPageSettingsViewModel}}">
    <StackPanel Margin="3">
        <StackPanel.Resources>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
            </Style>
        </StackPanel.Resources>
        <controls:SettingsColumns>
            <CheckBox Content="{DynamicResource LOC_SPG_SkipGamesInPreviousTimeframes}" IsChecked="{Binding Settings.SkipGamesInPreviousMostPlayed}"/>
            <CheckBox Content="{DynamicResource LOCGameHiddenTitle}" IsChecked="{Binding Settings.ShowHiddenInMostPlayed}"/>
        </controls:SettingsColumns>
        <controls:SettingsHint Text="Each row shows the most played game of its timeframe; Skip passes over that many of the top games first." Margin="0,8,0,2"/>
        <ItemsControl x:Name="TimeframeRows" ItemsSource="{Binding Settings.MostPlayedOptions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type m:MostPlayedOptions}">
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Source={ext:EnumBindingSource {x:Type m:Timeframe}}}" SelectedValue="{Binding Timeframe}"/>
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}" Text="{DynamicResource LOC_SPG_SkippedGames}" Margin="8,0,4,0" VerticalAlignment="Center"/>
                        <numeric:IntBox Grid.Column="2" MinValue="0" Width="64" Value="{Binding SkippedGames, UpdateSourceTrigger=LostFocus}"
                                        Style="{StaticResource {x:Type TextBox}}" VerticalContentAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
