<UserControl x:Class="LandingPage.Views.Settings.TextWidgetSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:LandingPage.Controls" Foreground="{DynamicResource TextBrush}">
 <StackPanel Margin="0,8">
  <controls:SettingsField Label="Heading or note">
   <TextBox x:Name="NoteText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
            MinHeight="100" MaxHeight="240" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
  </controls:SettingsField>
  <controls:SettingsField Label="Font size and formatting">
   <controls:TextFormatBar x:Name="FormatBar" TextSize="{Binding FontSize}" MinSize="8" MaxSize="200" Bold="{Binding Bold}" Italic="{Binding Italic}"
                           Color="{Binding Color}" UseCustomColor="{Binding UseCustomColor}"/>
  </controls:SettingsField>
  <controls:SettingsColumns x:Name="AlignmentColumns">
   <controls:SettingsField Label="Text alignment">
    <ComboBox SelectedValue="{Binding Alignment}" SelectedValuePath="Tag">
     <ComboBoxItem Content="Left" Tag="{x:Static TextAlignment.Left}"/>
     <ComboBoxItem Content="Center" Tag="{x:Static TextAlignment.Center}"/>
     <ComboBoxItem Content="Right" Tag="{x:Static TextAlignment.Right}"/>
     <ComboBoxItem Content="Justify" Tag="{x:Static TextAlignment.Justify}"/>
    </ComboBox>
   </controls:SettingsField>
   <controls:SettingsField Label="Vertical alignment">
    <ComboBox SelectedValue="{Binding VerticalAlignment}" SelectedValuePath="Tag">
     <ComboBoxItem Content="Top" Tag="{x:Static VerticalAlignment.Top}"/>
     <ComboBoxItem Content="Center" Tag="{x:Static VerticalAlignment.Center}"/>
     <ComboBoxItem Content="Bottom" Tag="{x:Static VerticalAlignment.Bottom}"/>
    </ComboBox>
   </controls:SettingsField>
  </controls:SettingsColumns>
  <CheckBox Content="Wrap text" IsChecked="{Binding Wrap}" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"/>
 </StackPanel>
</UserControl>
