<UserControl x:Class="LandingPage.Views.Settings.FeaturedGameSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:settings="clr-namespace:LandingPage.Settings" xmlns:local="clr-namespace:LandingPage.Views.Settings" xmlns:controls="clr-namespace:LandingPage.Controls" xmlns:numeric="http://gu.se/NumericInput">
 <UserControl.Resources>
  <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <StackPanel>
  <Expander Header="Game selection" Foreground="{DynamicResource TextBrush}" IsExpanded="True"><StackPanel Margin="8,6,0,8">
   <controls:SettingsField Label="Featured game source">
   <ComboBox SelectedValue="{Binding Source}" SelectedValuePath="Tag">
    <ComboBoxItem Content="Pinned game" Tag="{x:Static settings:FeaturedGameSource.Pinned}"/>
    <ComboBoxItem Content="Last played" Tag="{x:Static settings:FeaturedGameSource.LastPlayed}"/>
    <ComboBoxItem Content="Recently added" Tag="{x:Static settings:FeaturedGameSource.LastAdded}"/>
    <ComboBoxItem Content="Random game" Tag="{x:Static settings:FeaturedGameSource.Random}"/>
    <ComboBoxItem Content="Random favorite" Tag="{x:Static settings:FeaturedGameSource.RandomFavorite}"/>
    <ComboBoxItem Content="Selected library game" Tag="{x:Static settings:FeaturedGameSource.SelectedGame}"/>
    <ComboBoxItem Content="Hovered StartPage game" Tag="{x:Static settings:FeaturedGameSource.HoveredGame}"/>
    <ComboBoxItem Content="Hovered game, otherwise selected game" Tag="{x:Static settings:FeaturedGameSource.HoveredOrSelectedGame}"/>
   </ComboBox></controls:SettingsField>
   <controls:SettingsField Label="Hover update delay (milliseconds)">
   <numeric:IntBox Value="{Binding HoverDelayMilliseconds}" MinValue="0" MaxValue="1000" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
   <CheckBox Content="Keep last hovered game (hover-only mode)" IsChecked="{Binding KeepLastHoveredGame}" Margin="0,4,0,0"/>
   <controls:SettingsHint Text="Hover follows games in StartPage shelves and Most Played without changing the library selection. The combined mode returns to the selected game when the pointer leaves a game. Automatic filters apply to both modes." Margin="0,6,0,4"/>
   <controls:SettingsField Label="Pinned game"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PinnedGameName}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Choose pinned game..." Click="ChooseGame_Click" Margin="6,0,0,0" Padding="10,4"/></Grid></controls:SettingsField>
   <controls:SettingsColumns><CheckBox Content="Installed games only (automatic selection)" IsChecked="{Binding InstalledOnly}"/>
   <CheckBox Content="Include hidden games (automatic selection)" IsChecked="{Binding IncludeHidden}"/></controls:SettingsColumns>
   <controls:SettingsHint Text="Random selection stays fixed while switching pages. Use Another game to choose again. Explicitly pinned games ignore the automatic filters." Margin="0,6,0,0"/>
  </StackPanel></Expander>
  <Expander Header="Sections and actions" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"><StackPanel Margin="8,6,0,8">
   <controls:SettingsColumns><CheckBox Content="Show game title" IsChecked="{Binding ShowTitle}"/>
   <CheckBox Content="Show section headings" IsChecked="{Binding ShowSectionHeadings}"/>
   <CheckBox Content="Show description" IsChecked="{Binding ShowDescription}"/>
   <CheckBox Content="Show playtime" IsChecked="{Binding ShowPlaytime}"/>
   <CheckBox Content="Show last played" IsChecked="{Binding ShowLastPlayed}"/>
   <CheckBox Content="Show source name and icon" IsChecked="{Binding ShowSource}"/>
   <CheckBox Content="Show achievement progress" IsChecked="{Binding ShowAchievements}"/>
   <CheckBox Content="Show Play / Install button" IsChecked="{Binding ShowPlayButton}"/>
   <CheckBox Content="Show Open in library button" IsChecked="{Binding ShowLibraryButton}"/></controls:SettingsColumns>
   <controls:SettingsField Label="Description length (characters; 0 = all)">
   <numeric:IntBox Value="{Binding DescriptionLength}" MinValue="0" MaxValue="2147483647" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
   <controls:SettingsColumns><CheckBox Content="Preserve HTML formatting (same renderer as the library)" IsChecked="{Binding PreserveDescriptionFormatting}"/>
   <CheckBox Content="Show images from the description" IsChecked="{Binding ShowDescriptionImages}"/></controls:SettingsColumns>
   <controls:SettingsHint Text="Images appear in their original order with the text. Small images keep their natural size; larger images shrink to fit the section width. Remote images require an internet connection. Turn off Show description to hide all description content." Margin="0,6,0,0"/>
   <controls:SettingsHint Text="Achievements use the provider selected in StartPage settings and show only when data is available." Margin="0,6,0,0"/>
  </StackPanel></Expander>
  <Expander Header="Game details" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"><StackPanel Margin="8,6,0,8">
   <CheckBox Content="Show game details section" IsChecked="{Binding ShowGameDetails}" Margin="0,3"/>
   <StackPanel IsEnabled="{Binding ShowGameDetails}" Margin="12,4,0,0">
    <controls:SettingsColumns><CheckBox Content="Platforms" IsChecked="{Binding ShowPlatforms}"/>
    <CheckBox Content="Genres" IsChecked="{Binding ShowGenres}"/>
    <CheckBox Content="Release date" IsChecked="{Binding ShowReleaseDate}"/>
    <CheckBox Content="Developers" IsChecked="{Binding ShowDevelopers}"/>
    <CheckBox Content="Publishers" IsChecked="{Binding ShowPublishers}"/></controls:SettingsColumns>
   </StackPanel></StackPanel></Expander>
  <Expander Header="Library information" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"><StackPanel Margin="8,6,0,8">
   <CheckBox Content="Show library information section" IsChecked="{Binding ShowLibraryDetails}" Margin="0,3"/>
   <StackPanel IsEnabled="{Binding ShowLibraryDetails}" Margin="12,4,0,0">
    <controls:SettingsColumns><CheckBox Content="Completion status" IsChecked="{Binding ShowCompletionStatus}"/>
    <CheckBox Content="Categories" IsChecked="{Binding ShowCategories}"/>
    <CheckBox Content="Tags" IsChecked="{Binding ShowTags}"/>
    <CheckBox Content="Features" IsChecked="{Binding ShowFeatures}"/>
    <CheckBox Content="Date added" IsChecked="{Binding ShowDateAdded}"/>
    <CheckBox Content="Installation status" IsChecked="{Binding ShowInstallationStatus}"/>
    <CheckBox Content="Game version" IsChecked="{Binding ShowVersion}"/></controls:SettingsColumns>
   </StackPanel></StackPanel></Expander>
  <Expander Header="Scores" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"><StackPanel Margin="8,6,0,8">
   <CheckBox Content="Show scores section" IsChecked="{Binding ShowScores}" Margin="0,3"/>
   <StackPanel IsEnabled="{Binding ShowScores}" Margin="12,4,0,0">
    <controls:SettingsColumns><CheckBox Content="User score" IsChecked="{Binding ShowUserScore}"/>
    <CheckBox Content="Critic score" IsChecked="{Binding ShowCriticScore}"/>
    <CheckBox Content="Community score" IsChecked="{Binding ShowCommunityScore}"/></controls:SettingsColumns>
   </StackPanel></StackPanel></Expander>
  <Expander Header="Links" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"><StackPanel Margin="8,6,0,8"><CheckBox Content="Show game links" IsChecked="{Binding ShowLinks}"/><TextBlock Text="Show website links from the game details. Empty fields and sections are hidden automatically." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Expander>
  <Expander Header="Scrolling" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"><StackPanel Margin="8,6,0,8">
   <controls:SettingsHint Text="Overflow is scrollable automatically. With custom layout, each section scrolls within its own size."/>
   <CheckBox Content="Automatically scroll overflowing content" IsChecked="{Binding AutoScrollContent}" Margin="0,6,0,4"/>
   <CheckBox Content="Pause automatic scrolling while hovering" IsChecked="{Binding PauseAutoScrollOnHover}"/>
   <controls:SettingsSlider Label="Scroll speed (pixels per second)" Value="{Binding AutoScrollSpeed}" Minimum="1" Maximum="120" Step="1" Precision="0"/>
   <controls:SettingsHint Text="Scrolling starts after two seconds and pauses while moving/resizing sections or while Playnite is inactive. If pause-on-hover is checked, move the pointer outside the content to start. It waits at the beginning/end and loops to the top." Margin="0,6,0,0"/>
  </StackPanel></Expander>
  <Expander Header="Shared section appearance" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"><StackPanel Margin="8,6,0,8">
   <controls:SettingsHint Text="Applies to all sections unless a section overrides it. Works with both automatic and custom section layouts." Margin="0,0,0,6"/>
   <local:SectionAppearanceSettingsView DataContext="{Binding SectionAppearance}"/>
  </StackPanel></Expander>
  <Expander Header="Individual section appearance" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"><StackPanel Margin="8,6,0,8">
   <controls:SettingsHint Text="Enable an override to style a section independently. Uncheck it to return to the shared appearance. Custom layout positions replace automatic spacing." Margin="0,0,0,6"/>
   <ItemsControl ItemsSource="{Binding SectionLayouts}"><ItemsControl.ItemTemplate><DataTemplate>
    <Expander Header="{Binding Name}" Foreground="{DynamicResource TextBrush}" Margin="0,4"><StackPanel Margin="8,6,0,8">
     <CheckBox Content="Override shared section appearance" IsChecked="{Binding OverrideAppearance}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
     <local:SectionAppearanceSettingsView DataContext="{Binding Appearance}" IsEnabled="{Binding DataContext.OverrideAppearance, RelativeSource={RelativeSource AncestorType=StackPanel}}"/>
    </StackPanel></Expander>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Expander>
  <Expander Header="Section layout" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"><StackPanel Margin="8,6,0,8">
   <CheckBox Content="Use custom section layout" IsChecked="{Binding UseCustomSectionLayout}"/>
   <controls:SettingsHint Text="Press Edit sections on widget to close Appearance and show the section handles. Drag anywhere inside a section, including its text, to move it. Use corner grips to resize. Press Done sections, Escape, or exit dashboard Edit Mode to lock the layout. Positions are relative to this widget; exact values can also be entered below." Margin="0,6,0,8"/>
   <Button Content="Edit sections on widget" Click="BeginSectionEditing_Click" IsEnabled="{Binding UseCustomSectionLayout}" Margin="0,0,0,8"/>
   <ItemsControl ItemsSource="{Binding SectionLayouts}" IsEnabled="{Binding UseCustomSectionLayout}"><ItemsControl.ItemTemplate><DataTemplate>
    <Expander Header="{Binding Name}" Foreground="{DynamicResource TextBrush}" Margin="0,4"><StackPanel Margin="8,6,0,8">
     <controls:SettingsColumns><controls:SettingsField Label="Horizontal position"><numeric:DoubleBox Value="{Binding X}" MinValue="0" MaxValue="5000" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
     <controls:SettingsField Label="Vertical position"><numeric:DoubleBox Value="{Binding Y}" MinValue="0" MaxValue="5000" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
     <controls:SettingsField Label="Width"><numeric:DoubleBox Value="{Binding Width}" MinValue="120" MaxValue="1400" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
     <controls:SettingsField Label="Height"><numeric:DoubleBox Value="{Binding Height}" MinValue="48" MaxValue="2000" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField></controls:SettingsColumns>
    </StackPanel></Expander>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button Content="Reset section layout" Click="ResetSectionLayout_Click" Margin="0,8,0,0"/>
  </StackPanel></Expander>
<Expander Header="Text formatting" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="8,6,0,8"><controls:TextSettingsSelector x:Name="TextEditor">
<controls:TextSettingsEntry Header="Title"><StackPanel><controls:SettingsField Label="Title size and color"><controls:TextFormatBar x:Name="TitleFormatBar" ShowStyle="False" TextSize="{Binding TitleSize}" MinSize="12" MaxSize="96" Color="{Binding TitleColor}" UseCustomColor="{Binding UseCustomTextColor}"/></controls:SettingsField></StackPanel></controls:TextSettingsEntry>
<controls:TextSettingsEntry Header="Description / other text"><StackPanel><controls:SettingsField Label="Text size and color"><controls:TextFormatBar x:Name="TextFormatBar" ShowStyle="False" TextSize="{Binding TextSize}" MinSize="8" MaxSize="48" Color="{Binding TextColor}" UseCustomColor="{Binding UseCustomTextColor}"/></controls:SettingsField></StackPanel></controls:TextSettingsEntry>
<controls:TextSettingsEntry Header="Metadata">  <StackPanel Margin="8,6,0,8">
   <CheckBox Content="Use the same size as description text" IsChecked="{Binding MatchMetadataTextSize}"/>
   <controls:SettingsField Label="Metadata text size and color"><controls:TextFormatBar x:Name="MetadataFormatBar" ShowStyle="False" TextSize="{Binding MetadataTextSize}" MinSize="8" MaxSize="48" Color="{Binding MetadataTextColor}" UseCustomColor="{Binding UseCustomMetadataColor}"/></controls:SettingsField>
   <CheckBox Content="Use the same color as description text" IsChecked="{Binding MatchMetadataTextColor}" Margin="0,8,0,4"/>






   <CheckBox Content="Match icon size to metadata text" IsChecked="{Binding MatchMetadataIconSize}" Margin="0,8,0,4"/>
   <controls:SettingsField Label="Metadata icon size">
   <numeric:DoubleBox Value="{Binding MetadataIconSize}" MinValue="8" MaxValue="64" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
   <controls:SettingsHint Text="Sizes apply independently of custom colors. When matching text color, theme colors are retained unless custom text colors are enabled." Margin="0,6,0,0"/>
  </StackPanel>
</controls:TextSettingsEntry>
</controls:TextSettingsSelector>
</StackPanel></Expander>
  <Expander Header="Artwork and content layout" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"><StackPanel Margin="8,6,0,8">
   <CheckBox Content="Show artwork" IsChecked="{Binding ShowArtwork}"/>
   <CheckBox Content="Use cover instead of background artwork" IsChecked="{Binding UseCoverArtwork}" Margin="0,4,0,0"/>
   <controls:SettingsField Label="Artwork sizing">
   <ComboBox SelectedValue="{Binding ArtworkSizing}" SelectedValuePath="Tag">
    <ComboBoxItem Content="Fill widget (crop edges)" Tag="{x:Static settings:FeaturedArtworkSizing.Fill}"/>
    <ComboBoxItem Content="Fit entire image (no cropping)" Tag="{x:Static settings:FeaturedArtworkSizing.Fit}"/>
    <ComboBoxItem Content="Fit without enlarging small images" Tag="{x:Static settings:FeaturedArtworkSizing.FitWithoutEnlarging}"/>
    <ComboBoxItem Content="Stretch to widget (may distort image)" Tag="{x:Static settings:FeaturedArtworkSizing.Stretch}"/>
    <ComboBoxItem Content="Original size (may crop large images)" Tag="{x:Static settings:FeaturedArtworkSizing.OriginalSize}"/>
   </ComboBox></controls:SettingsField>
   <controls:SettingsSlider Label="Artwork opacity" Value="{Binding ArtworkOpacity}" Minimum="0" Maximum="1" Step="0.01" Precision="2"/>
   <controls:SettingsSlider Label="Artwork overlay opacity" Value="{Binding OverlayOpacity}" Minimum="0" Maximum="1" Step="0.01" Precision="2"/>


   <controls:SettingsField Label="Maximum content width"><numeric:DoubleBox Value="{Binding ContentWidth}" MinValue="160" MaxValue="1400" Style="{StaticResource {x:Type TextBox}}"/></controls:SettingsField>
<Expander Header="Colors" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,6"><UniformGrid Columns="3" Margin="8,6,0,8">
   <controls:PopupColorPicker Label="Artwork overlay color" ShowCustomColorOption="False" Margin="0,4,8,4" SelectedColor="{Binding OverlayColor, Mode=TwoWay, ValidatesOnExceptions=True}"/>




</UniformGrid></Expander>
   <controls:SettingsColumns><controls:SettingsField Label="Horizontal content position">
   <ComboBox SelectedValue="{Binding Alignment}" SelectedValuePath="Tag">
    <ComboBoxItem Content="Left" Tag="{x:Static HorizontalAlignment.Left}"/>
    <ComboBoxItem Content="Center" Tag="{x:Static HorizontalAlignment.Center}"/>
    <ComboBoxItem Content="Right" Tag="{x:Static HorizontalAlignment.Right}"/>
   </ComboBox></controls:SettingsField>
   <controls:SettingsField Label="Vertical content position">
   <ComboBox SelectedValue="{Binding VerticalAlignment}" SelectedValuePath="Tag">
    <ComboBoxItem Content="Top" Tag="{x:Static VerticalAlignment.Top}"/>
    <ComboBoxItem Content="Center" Tag="{x:Static VerticalAlignment.Center}"/>
    <ComboBoxItem Content="Bottom" Tag="{x:Static VerticalAlignment.Bottom}"/>
   </ComboBox></controls:SettingsField></controls:SettingsColumns>
  </StackPanel></Expander>
 </StackPanel>
</UserControl>
