<UserControl x:Class="LandingPage.Views.ClockView" x:Name="ClockRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="ClockVisibility"/></UserControl.Resources>
    <Viewbox StretchDirection="DownOnly"
             HorizontalAlignment="{Binding Settings.HorizontalAlignment, ElementName=ClockRoot}"
             VerticalAlignment="{Binding Settings.VerticalAlignment, ElementName=ClockRoot}">
        <StackPanel>
            <TextBlock x:Name="ClockTextBlock" FontSize="{Binding Settings.TimeSize, ElementName=ClockRoot}" TextAlignment="Center" Padding="0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Settings.UseCustomColors, ElementName=ClockRoot}" Value="True">
                            <Setter Property="Foreground" Value="{Binding Settings.TimeColor, ElementName=ClockRoot}"/>
                        </DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding Clock.TimeString, ElementName=ClockRoot, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Clock.T, ElementName=ClockRoot, Mode=OneWay}" FontSize="{Binding Settings.DesignatorSize, ElementName=ClockRoot}"/>
            </TextBlock>
            <TextBlock x:Name="DateStringTextBlock" Text="{Binding Clock.DateString, ElementName=ClockRoot}" TextAlignment="Center"
                       FontSize="{Binding Settings.DateSize, ElementName=ClockRoot}"
                       Visibility="{Binding Settings.ShowDate, ElementName=ClockRoot, Converter={StaticResource ClockVisibility}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Settings.UseCustomColors, ElementName=ClockRoot}" Value="True">
                            <Setter Property="Foreground" Value="{Binding Settings.DateColor, ElementName=ClockRoot}"/>
                        </DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Viewbox>
</UserControl>
